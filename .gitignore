.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user
.claude/

# Local environment and secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# .NET, MSBuild, and WinUI generated output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]64/
AppPackages/
BundleArtifacts/
Generated Files/
TestResults/
*.binlog
*.buildlog
*.log

# NuGet and package output
packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# Publish, installer, and release artifacts
artifacts/
publish/
*.msix
*.msixbundle
*.appx
*.appxbundle
*.wapproj.user
*.exe
!src/**/Assets/*.exe

# Test coverage and diagnostics
coverage/
coverage.*/
*.coverage
*.coveragexml
*.trx
*.cobertura.xml
*.opencover.xml

# Local runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.tmp
*.temp

# Local AI/tool state and archived generated output
.aictx/
.codex_memory/
.kimi-code/
DevDocsDownloader/
archive/generated/
archive/local/
archive/external/

# Local demo fixtures and generated presentation output
demo/
outputs/

# Internal agent working files (not public documentation)
PROJECT_STATE.md
WORK_STATUS.md

# Rust build output
target/
**/target/

# Keep Rust application lockfiles committed for reproducible release builds.
!turbo-scanner/Cargo.lock

#misc
docs/AIprojectcontext/

# Internal working/session artifacts
BenchmarkDotNet.Artifacts/
