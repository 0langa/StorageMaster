<Project>
  <!--
    WinUI local builds currently fail with WMC9999 when the managed in-process
    XAML compiler is forced on. Keep the supported executable compiler enabled
    so `dotnet build` and `dotnet test` work consistently locally and in CI.
  -->
  <PropertyGroup>
    <UseXamlCompilerExecutable>true</UseXamlCompilerExecutable>
  </PropertyGroup>
</Project>
