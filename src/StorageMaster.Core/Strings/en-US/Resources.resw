    <value>Close</value>
  </data>
  <data name="Common_Delete" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="Common_Free" xml:space="preserve">
    <value>free</value>
  </data>
  <data name="Common_Healthy" xml:space="preserve">
    <value>Healthy</value>
  </data>
  <data name="Common_Off" xml:space="preserve">
    <value>Off</value>
    <comment>[label] ToggleSwitch caption when the switch is off.</comment>
  </data>
  <data name="Common_On" xml:space="preserve">
    <value>On</value>
    <comment>[label] ToggleSwitch caption when the switch is on. Windows uses this beside every switch.</comment>
