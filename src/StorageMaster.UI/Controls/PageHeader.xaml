<UserControl
    x:Class="StorageMaster.UI.Controls.PageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Visibility="{x:Bind HasSubtitle, Mode=OneWay}" />
        </StackPanel>
        <ContentPresenter Grid.Column="1"
                          Content="{x:Bind ActionContent, Mode=OneWay}"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>
