<UserControl
    x:Class="StorageMaster.UI.Controls.SettingsCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ItemsWrapGrid gives every tile the height of the first one it measures, so
        MinHeight has to clear the tallest content rather than the first. At 150 a
        Spanish description wrapped to a third line and pushed the summary below
        the tile's bottom edge.
    -->
    <Border Style="{StaticResource SettingsTileCardStyle}"
            MinWidth="280"
            MinHeight="185"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
            AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}">
        <StackPanel Spacing="{StaticResource TightSpacing}">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                      FontSize="28"
                      HorizontalAlignment="Left"
                      Foreground="{StaticResource SmAccentOnSurfaceBrush}" />
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <InfoBar Message="{x:Bind WarningText, Mode=OneWay}"
                     Severity="Warning"
                     IsOpen="{x:Bind HasWarning, Mode=OneWay}"
                     IsClosable="False" />
        </StackPanel>
    </Border>
</UserControl>
