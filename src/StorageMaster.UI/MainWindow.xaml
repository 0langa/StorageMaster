<Window
    x:Class="StorageMaster.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    mc:Ignorable="d"
    Title="StorageMaster">

    <!--
        The window root is painted explicitly. With the Mica backdrop disabled and
        no background set, any pixel neither the pane nor the content covers falls
        through to the bare window and renders black — which showed up in light
        theme as hard black seams between the panels.
    -->
    <Grid Background="{StaticResource SmSurfaceSunkenBrush}">
        <NavigationView
            x:Name="NavView"
            AutomationProperties.Name="{i18n:Loc Key=Nav_AutomationName}"
            PaneDisplayMode="Auto"
            OpenPaneLength="300"
            CompactPaneLength="56"
            IsBackButtonVisible="Visible"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            BackRequested="NavView_BackRequested"
            SelectionChanged="NavView_SelectionChanged">

            <!--
                The pane background is set here rather than left to
                NavigationViewDefaultPaneBackground. That key lives in
                XamlControlsResources' ThemeDictionaries, and a plain override
                merged at Application level does not reliably win against it — in
                light theme the rail stayed dark while the page turned light.
                Setting the resource on this element puts it in the pane's own
                lookup scope, where it does.
            -->
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SmSurfaceSunkenBrush" />
                <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SmSurfaceSunkenBrush" />
                <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SmSurfaceBaseBrush" />
            </NavigationView.Resources>

            <!--
                The header is the app's status strip: identity on the left, live
                scan and monitoring state on the right, separated from the page by
                a single rule. Everything below it belongs to the page.
            -->
            <NavigationView.Header>
                <Grid Padding="24,14,24,14" ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" Spacing="2" MinWidth="170">
                        <TextBlock Text="StorageMaster"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{i18n:Loc Key=Shell_Subtitle}"
                                   Style="{StaticResource GlobalStatusTextStyle}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                        <TextBlock x:Name="LatestScanStatusText"
                                   Grid.Column="0"
                                   Text="{i18n:Loc Key=Shell_NoScanLoaded}"
                                   Style="{StaticResource GlobalStatusTextStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="WarningStatusText"
                                   Grid.Column="1"
                                   Text="{i18n:Loc Key=Shell_MonitoringActive}"
                                   Style="{StaticResource GlobalStatusTextStyle}" />
                    </Grid>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="{i18n:Loc Key=Nav_Overview}" />
                <NavigationViewItem Tag="Dashboard" Icon="Home" Content="{i18n:Loc Key=Nav_Dashboard}" AutomationProperties.Name="{i18n:Loc Key=Nav_Dashboard}" />

                <NavigationViewItemHeader Content="{i18n:Loc Key=Nav_Analyze}" />
                <NavigationViewItem Tag="Scan" Icon="Find" Content="{i18n:Loc Key=Nav_Scan}" AutomationProperties.Name="{i18n:Loc Key=Nav_Scan}" />
                <NavigationViewItem Tag="ScanWorkspace" Content="{i18n:Loc Key=Nav_ScanWorkspace}" AutomationProperties.Name="{i18n:Loc Key=Nav_ScanWorkspace}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource IconResults}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Results" Icon="List" Content="{i18n:Loc Key=Nav_Results}" AutomationProperties.Name="{i18n:Loc Key=Nav_Results}" />
                <NavigationViewItem Tag="SpaceMap" Content="{i18n:Loc Key=Nav_SpaceMap}" AutomationProperties.Name="{i18n:Loc Key=Nav_SpaceMap}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource IconSpaceMap}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Duplicates" Icon="Copy" Content="{i18n:Loc Key=Nav_Duplicates}" AutomationProperties.Name="{i18n:Loc Key=Nav_Duplicates}" />

                <NavigationViewItemHeader Content="{i18n:Loc Key=Nav_Clean}" />
                <NavigationViewItem Tag="Cleanup" Icon="Delete" Content="{i18n:Loc Key=Nav_Cleanup}" AutomationProperties.Name="{i18n:Loc Key=Nav_Cleanup}" />
                <NavigationViewItem Tag="SmartCleaner" Content="{i18n:Loc Key=Nav_SmartCleaner}" AutomationProperties.Name="{i18n:Loc Key=Nav_SmartCleaner}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource IconSmartCleaner}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{i18n:Loc Key=Nav_Monitor}" />
                <NavigationViewItem Tag="DriveHealth" Content="{i18n:Loc Key=Nav_DriveHealth}" AutomationProperties.Name="{i18n:Loc Key=Nav_DriveHealth}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource IconHealth}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border x:Name="PaneFooterBorder"
                        Margin="12" Padding="12"
                        CornerRadius="{StaticResource TileCornerRadius}"
                        Background="{StaticResource SmSurfaceSunkenBrush}"
                        BorderBrush="{StaticResource SmStrokeSubtleBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Loc Key=Shell_GlobalStatus}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PaneLatestScanText" Text="{i18n:Loc Key=Shell_LatestScanUnavailable}" Style="{StaticResource GlobalStatusTextStyle}" />
                        <TextBlock x:Name="PaneDiskStatusText" Text="{i18n:Loc Key=Shell_DiskMonitorStarting}" Style="{StaticResource GlobalStatusTextStyle}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!--
                The page surface, lifted off the shell rather than butted against it.
                Previously the rail met the content on a hard vertical seam and the
                header on a hard horizontal one, which read as two flat regions
                jammed together instead of a page resting on a chrome.

                A rounded leading edge with a hairline stroke gives the page an
                actual boundary, and painting the base here means every page — even
                ones this pass did not touch — sits on the same ground.
            -->
            <Border Margin="0,0,0,0"
                    CornerRadius="14,0,0,0"
                    BorderBrush="{StaticResource SmStrokeSubtleBrush}"
                    BorderThickness="1,1,0,0"
                    Background="{StaticResource SmSurfaceBaseBrush}">
                <Frame x:Name="ContentFrame" Background="Transparent" />
            </Border>
        </NavigationView>
    </Grid>
</Window>
