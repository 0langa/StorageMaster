<Page
    x:Class="StorageMaster.UI.Pages.CleanupPage"
    AutomationProperties.Name="Cleanup page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <converters:BoolNegationConverter     x:Key="NotBool" />
        <converters:BoolToChevronConverter    x:Key="ChevronConv" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">

            <!--
                Analyse is the page's primary action and sits in the header.
                Executing a cleanup stays a separate, explicitly enabled command
                further down, next to the dry-run checkbox and the selected total,
                so the destructive step is never the first button in reach.
            -->
            <controls:PageHeader Title="Cleanup"
                                 Subtitle="Preview recoverable cleanup candidates before any destructive operation.">
                <controls:PageHeader.ActionContent>
                    <Button Content="Analyse for cleanup opportunities"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="36"
                            Command="{x:Bind ViewModel.AnalyseCommand}"
                            IsEnabled="{x:Bind ViewModel.CanAnalyse, Mode=OneWay}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Review before delete"
                     Message="Analysis is read-only. Execution keeps Recycle Bin as the recommended path and dry-run can preview the exact selected categories." />

            <!-- ── Session selector ────────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <TextBlock Text="Select scan session" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="Cleanup uses a completed scan so recommendations stay explainable and reversible by default."
                               Style="{StaticResource HelperTextStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.RecentSessions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding RootPath}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding StartedUtc}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- ── Cleanup Options (grouped, expandable categories) ────────── -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource CardSpacing}">
                    <TextBlock Text="Cleanup options" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="Leave risky categories off unless you understand the side effects. Dry run stays available before any deletion."
                               Style="{StaticResource HelperTextStyle}" />

                    <!-- Deletion mode row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <ToggleSwitch Grid.Column="0"
                                      Header="Send to Recycle Bin (recommended)"
                                      IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}" />
                        <ToggleSwitch Grid.Column="1"
                                      Header="Clear entire Downloads folder (sub-option)"
                                      IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.ClearEntireDownloads, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="Categories to include" Style="{StaticResource MetricLabelTextStyle}" />

                    <!-- ── Grouped category list ──────────────────────────── -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryGroups}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CleanupCategoryGroup">
                                <Border Background="{StaticResource SmSurfaceSunkenBrush}"
                                        BorderBrush="{StaticResource SmStrokeSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource TileCornerRadius}" Margin="0,3" Padding="0">
                                    <StackPanel>

                                        <!-- Group header row -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10"
                                              ColumnSpacing="8">
                                            <!-- Chevron expand/collapse button -->
                                            <Button Grid.Column="0"
                                                    Content="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource ChevronConv}}"
                                                    Tag="{x:Bind}"
                                                    Click="GroupChevron_Click"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6,4"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    VerticalAlignment="Center" />

                                            <!-- Group icon + name -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind GroupIcon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SmTextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind GroupName}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Group-level toggle -->
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind IsGroupEnabled, Mode=TwoWay}"
                                                          OnContent="" OffContent=""
                                                          MinWidth="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Expandable individual items -->
                                        <ItemsControl ItemsSource="{x:Bind Items}"
                                                      Padding="12,0,12,10"
                                                      Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:CleanupCategoryOption">
                                                    <Border Background="{StaticResource SmSurfaceRaisedBrush}"
                                                            BorderBrush="{StaticResource SmStrokeSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource ButtonCornerRadius}" Padding="12,10" Margin="0,3">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                            <ToggleSwitch Grid.Column="0"
                                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"
                                                                          OnContent="" OffContent=""
                                                                          MinWidth="0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{x:Bind Description}"
                                                                           Style="{StaticResource HelperTextStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Large-file / old-file sliders — visible only when LargeOldFiles category is on -->
                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.IsLargeOldFilesEnabled, Mode=OneWay, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LargeFileSizeLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                            <Slider Minimum="50" Maximum="5000" StepFrequency="50"
                                    IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.LargeFileSizeMb, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.OldFileAgeLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                            <Slider Minimum="30" Maximum="3650" StepFrequency="30"
                                    IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.OldFileAgeDays, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Visibility="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource InvBoolVis}}"/>

            <!-- Analysis loading spinner -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolVis}}"
                          Width="36" Height="36" HorizontalAlignment="Left" />

            <!-- Execution progress -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <TextBlock Text="{x:Bind ViewModel.CleanupProgressText, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind ViewModel.CleanupProgressValue, Mode=OneWay}"
                                 Maximum="100" Height="8" />
                </StackPanel>
            </Border>

            <!-- Suggestions list -->
            <StackPanel Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolVis}}"
                        Spacing="12">

                <TextBlock Text="Suggestions" Style="{StaticResource SectionHeaderTextStyle}" />

                <!--  A ListView measured with infinite height has an infinite viewport,
                      so ItemsStackPanel culls nothing and realises every row. The page
                      root is a ScrollViewer, which supplies exactly that infinite
                      height. One rule alone can emit a thousand suggestions, so the
                      list is bounded here to keep virtualisation working, matching
                      what DuplicatesPage already does.  -->
                <ListView ItemsSource="{x:Bind ViewModel.Suggestions}"
                          SelectionMode="None"
                          MinHeight="{StaticResource ListMinHeight}"
                          MaxHeight="{StaticResource ListMaxHeightTall}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,3" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SuggestionItem">
                            <Border Style="{StaticResource ListRowCardStyle}">
                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Compiled binding: the template already declares
                                         x:DataType, so the reflection binding cost a
                                         BindingExpression per row for no benefit. -->
                                    <CheckBox Grid.Column="0" Grid.RowSpan="2"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                        <TextBlock Text="{x:Bind Suggestion.Title}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Suggestion.Description}"
                                                   Style="{StaticResource HelperTextStyle}"
                                                   MaxLines="2"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="{x:Bind SizeDisplay}"
                                               Style="{StaticResource MetricValueTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               MinWidth="90" TextAlignment="Right"/>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind CategoryDisplay}"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <Border Style="{StaticResource StatusChipStyle}">
                                            <TextBlock Text="{x:Bind RiskDisplay}"
                                                       Style="{StaticResource StatusChipTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ConfidenceDisplay}"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{x:Bind PolicyDisplay}"
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="2"
                                               Text="{x:Bind Suggestion.SafetyNotes}"
                                               Style="{StaticResource HelperTextStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Execute bar -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="{StaticResource CardPaddingCompact}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                        <StackPanel Grid.Column="0" Spacing="{StaticResource TightSpacing}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Selected" Style="{StaticResource MetricLabelTextStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.TotalSelectedSize, Mode=OneWay}"
                                           Style="{StaticResource MetricTextStyle}"/>
                            </StackPanel>
                            <CheckBox Content="Dry run (preview only)"
                                      IsEnabled="{x:Bind ViewModel.CanChangeAnalysisScope, Mode=OneWay}"
                                      IsChecked="{x:Bind ViewModel.IsDryRun, Mode=TwoWay}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clean Up Selected…"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanExecuteCleanup, Mode=OneWay}"
                                Click="ExecuteButton_Click"/>
                    </Grid>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
