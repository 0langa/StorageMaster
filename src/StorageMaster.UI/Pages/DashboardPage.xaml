<Page
    x:Class="StorageMaster.UI.Pages.DashboardPage"
    x:Name="PageRoot"
    AutomationProperties.Name="Dashboard page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="1120" HorizontalAlignment="Center">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleLargeTextBlockStyle}" />

            <Border Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}"
                                   Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.82" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.72" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Recommended next step"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.RecommendedActionText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LatestScanSummary, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.72" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasRecommendations, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Scan drive or folder" Command="{x:Bind ViewModel.GoToScanCommand}" />
                <Button Grid.Column="1" Content="Latest Results" Command="{x:Bind ViewModel.GoToResultsCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="2" Content="Review Duplicates" Command="{x:Bind ViewModel.GoToDuplicatesCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="3" Content="Run Cleanup" Command="{x:Bind ViewModel.GoToCleanupCommand}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Smart Cleaner" Command="{x:Bind ViewModel.GoToSmartCleanerCommand}" />
                <Button Grid.Column="1" Content="Space Map" Command="{x:Bind ViewModel.GoToSpaceMapCommand}" />
                <Button Grid.Column="2" Content="Open latest scan" Command="{x:Bind ViewModel.GoToResultsCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="3" Content="Start new scan" Command="{x:Bind ViewModel.GoToScanCommand}" />
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Drive health" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DriveHealthSummary, Mode=OneWay}"
                               Opacity="0.72"
                               TextWrapping="WrapWholeWords" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Drives2, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FreeBytes, Converter={StaticResource ByteSize}}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding UsedBytes}" Maximum="{Binding TotalBytes}" Height="8" />
                                        <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}">
                                            <Run Text="{Binding VolumeLabel}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding DriveFormat}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
