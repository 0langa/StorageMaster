<Page
    x:Class="StorageMaster.UI.Pages.DashboardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="{i18n:Loc Key=Dashboard_AutomationName}">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">
            <!--
                Start Scan is the page's primary action and sits in the header,
                so the row below reads as navigation rather than as five equally
                weighted commands competing with each other.
            -->
            <controls:PageHeader Title="{i18n:Loc Key=Dashboard_Title}"
                                 Subtitle="{i18n:Loc Key=Dashboard_Subtitle}">
                <controls:PageHeader.ActionContent>
                    <Button Content="{i18n:Loc Key=Scan_Start}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="36"
                            Command="{x:Bind ViewModel.GoToScanCommand}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <Border Style="{StaticResource HeroCardStyle}">
                <!--
                    The score's explanation spans the whole card rather than sitting
                    in the gauge's 132px column. It never fitted there — English was
                    already being cut off at "low-space…" — and no translation was
                    going to make a 100-character sentence fit a column sized for a
                    two-word label.
                -->
                <Grid ColumnDefinitions="2*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource TightSpacing}">
                        <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource TightSpacing}">
                        <TextBlock Text="{i18n:Loc Key=Dashboard_RecommendedNextStep_Label}" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RecommendedActionText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{StaticResource SmAccentOnSurfaceBrush}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind ViewModel.LatestScanSummary, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="132" Spacing="{StaticResource TightSpacing}" VerticalAlignment="Center">
                        <controls:RadialGauge Value="{x:Bind ViewModel.ReadinessScore, Mode=OneWay}"
                                               Label="{x:Bind ViewModel.ReadinessLabel, Mode=OneWay}"
                                               GaugeSize="108"
                                               HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               Text="{x:Bind ViewModel.ReadinessDescription, Mode=OneWay}"
                               Style="{StaticResource HelperTextStyle}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource ControlSpacing}">
                <Button Grid.Column="0" Content="{i18n:Loc Key=Dashboard_Action_Workspace}" Style="{StaticResource CommandButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GoToWorkspaceCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="1" Content="{i18n:Loc Key=Nav_SpaceMap}" Style="{StaticResource CommandButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GoToSpaceMapCommand}" />
                <Button Grid.Column="2" Content="{i18n:Loc Key=Nav_Duplicates}" Style="{StaticResource CommandButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GoToDuplicatesCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="3" Content="{i18n:Loc Key=Dashboard_Action_SmartCleanup}" Style="{StaticResource CommandButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GoToSmartCleanerCommand}" />
            </Grid>

            <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="{StaticResource CardSpacing}">
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="{StaticResource CardSpacing}">
                        <TextBlock Text="{i18n:Loc Key=Dashboard_DriveOverview_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DriveHealthSnapshots, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource CardSpacing}">
                                            <controls:RadialGauge Grid.Column="0"
                                                                  Value="{Binding FreePercent}"
                                                                  Label="{i18n:Loc Key=Common_Free}"
                                                                  GaugeSize="78" />
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DriveName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource HelperTextStyle}" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                                    <Run Text="{Binding VolumeLabel}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding DriveFormat}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding MediaType}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <controls:SeverityBadge Grid.Column="2"
                                                                    Status="{Binding Status}"
                                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="{StaticResource CardSpacing}">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="{StaticResource TightSpacing}">
                            <TextBlock Text="{i18n:Loc Key=Dashboard_LatestScan_Label}" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalScannedSize, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="{StaticResource ControlSpacing}">
                            <TextBlock Text="{i18n:Loc Key=Dashboard_RecommendedActions_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
