<Page
    x:Class="StorageMaster.UI.Pages.DashboardPage"
    x:Name="PageRoot"
    AutomationProperties.Name="Dashboard page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">
            <controls:PageHeader Title="Overview"
                                 Subtitle="Storage health, latest scan context, and safe next actions." />

            <Border Style="{StaticResource HeroCardStyle}">
                <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="24">
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Recommended next step" Style="{StaticResource HelperTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RecommendedActionText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LatestScanSummary, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="132" Spacing="6" VerticalAlignment="Center">
                        <controls:RadialGauge Value="{x:Bind ViewModel.ReadinessScore, Mode=OneWay}"
                                               Label="{x:Bind ViewModel.ReadinessLabel, Mode=OneWay}"
                                               GaugeSize="108"
                                               HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ReadinessDescription, Mode=OneWay}"
                                   Style="{StaticResource HelperTextStyle}"
                                   MaxLines="3"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Content="Start Scan" Command="{x:Bind ViewModel.GoToScanCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Grid.Column="1" Content="Workspace" Command="{x:Bind ViewModel.GoToWorkspaceCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="2" Content="Space Map" Command="{x:Bind ViewModel.GoToSpaceMapCommand}" />
                <Button Grid.Column="3" Content="Duplicates" Command="{x:Bind ViewModel.GoToDuplicatesCommand}" IsEnabled="{x:Bind ViewModel.HasLastSession, Mode=OneWay}" />
                <Button Grid.Column="4" Content="Smart Cleanup" Command="{x:Bind ViewModel.GoToSmartCleanerCommand}" />
            </Grid>

            <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Drive overview" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DriveHealthSnapshots, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                            <controls:RadialGauge Grid.Column="0"
                                                                  Value="{Binding FreePercent}"
                                                                  Label="free"
                                                                  GaugeSize="78" />
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DriveName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource HelperTextStyle}" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                                    <Run Text="{Binding VolumeLabel}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding DriveFormat}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding MediaType}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <controls:SeverityBadge Grid.Column="2"
                                                                    Text="{Binding Status}"
                                                                    Status="{Binding Status}"
                                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Latest scan" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalScannedSize, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Recommended actions" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
