<Page
    x:Class="StorageMaster.UI.Pages.DriveHealthPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    mc:Ignorable="d"
    AutomationProperties.Name="{i18n:Loc Key=Health_Page_Automation}">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolNegationConverter x:Key="BoolNot" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">
            <controls:PageHeader Title="{i18n:Loc Key=Health_Title}"
                                 Subtitle="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                <controls:PageHeader.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
                        <Button Content="{i18n:Loc Key=Common_Refresh}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNot}}"
                                AutomationProperties.Name="{i18n:Loc Key=Health_Refresh_Automation}" />
                    </StackPanel>
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Snapshots, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                                <controls:RadialGauge Grid.Column="0"
                                                      Value="{Binding FreePercent}"
                                                      Label="{i18n:Loc Key=Common_Free}"
                                                      GaugeSize="104"
                                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding DriveName}"
                                                       Style="{StaticResource TitleTextBlockStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}"
                                                       Style="{StaticResource PageSubtitleTextStyle}"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:SeverityBadge Grid.Column="1"
                                                                Text="{Binding Status}"
                                                                Status="{Binding Status}"
                                                                VerticalAlignment="Top" />
                                    </Grid>

                                    <ProgressBar Value="{Binding FreeBytes}" Maximum="{Binding TotalBytes}" Height="8" />

                                    <!--
                                        Neutral chips: a volume label is a fact, not
                                        a state, so it no longer borrows the accent.
                                    -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource TightSpacing}">
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding MediaType}" Style="{StaticResource StatusChipTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DriveFormat}" Style="{StaticResource StatusChipTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding VolumeLabel}" Style="{StaticResource StatusChipTextStyle}" MaxWidth="160" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource StatusChipTextStyle}" MaxWidth="160" />
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource ControlSpacing}">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{i18n:Loc Key=Health_Metric_Free}" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock Text="{Binding FreeBytes, Converter={StaticResource ByteSize}}" Style="{StaticResource MetricValueTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{i18n:Loc Key=Health_Metric_Total}" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource ByteSize}}" Style="{StaticResource MetricValueTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="{i18n:Loc Key=Health_Metric_Captured}" Style="{StaticResource MetricLabelTextStyle}" />
                                            <TextBlock Text="{Binding CapturedUtc}" Style="{StaticResource MetricValueTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                    <TextBlock Text="{i18n:Loc Key=Health_Recommendation_Label}" Style="{StaticResource MetricLabelTextStyle}" />
                                    <TextBlock Text="{i18n:Loc Key=Health_Recommendation_Body}" Style="{StaticResource HelperTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
