<Page
    x:Class="StorageMaster.UI.Pages.DriveHealthPage"
    x:Name="PageRoot"
    AutomationProperties.Name="Drive Health page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolNegationConverter x:Key="BoolNot" />
    </Page.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Drive Health" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNot}}"
                        AutomationProperties.Name="Refresh drive health" />
            </Grid>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="28"
                          Height="28"
                          HorizontalAlignment="Left"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolVis}}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Snapshots, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding DriveName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="WrapWholeWords"
                                                   Opacity="0.76" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <ProgressBar Value="{Binding FreeBytes}"
                                             Maximum="{Binding TotalBytes}"
                                             Height="8" />

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0">
                                        <Run Text="Free " />
                                        <Run Text="{Binding FreeBytes, Converter={StaticResource ByteSize}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="Source " />
                                        <Run Text="{Binding Source}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2">
                                        <Run Text="Captured " />
                                        <Run Text="{Binding CapturedUtc}" />
                                    </TextBlock>
                                </Grid>

                                <TextBlock Opacity="0.68" TextWrapping="WrapWholeWords">
                                    <Run Text="{Binding Model}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding MediaType}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding DriveFormat}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
