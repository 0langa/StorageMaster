<Page
    x:Class="StorageMaster.UI.Pages.DriveHealthPage"
    x:Name="PageRoot"
    AutomationProperties.Name="Drive Health page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolNegationConverter x:Key="BoolNot" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">
            <controls:PageHeader Title="Drive Health"
                                 Subtitle="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                <controls:PageHeader.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
                        <Button Content="Refresh"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNot}}"
                                AutomationProperties.Name="Refresh drive health" />
                    </StackPanel>
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Snapshots, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                                <controls:RadialGauge Grid.Column="0"
                                                      Value="{Binding FreePercent}"
                                                      Label="free"
                                                      GaugeSize="104"
                                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding DriveName}" Style="{StaticResource TitleTextBlockStyle}" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource PageSubtitleTextStyle}" />
                                        </StackPanel>
                                        <controls:SeverityBadge Grid.Column="1"
                                                                Text="{Binding Status}"
                                                                Status="{Binding Status}"
                                                                VerticalAlignment="Top" />
                                    </Grid>

                                    <ProgressBar Value="{Binding FreeBytes}" Maximum="{Binding TotalBytes}" Height="8" />

                                    <ItemsControl>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding MediaType}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding DriveFormat}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding VolumeLabel}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusChipStyle}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding Source}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </ItemsControl>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Free" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding FreeBytes, Converter={StaticResource ByteSize}}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Total" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource ByteSize}}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Captured" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding CapturedUtc}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8" MinWidth="190">
                                    <TextBlock Text="Recommendation" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Run cleanup, review large folders, or move data if free space is low. Unknown states mean Windows did not expose reliable telemetry." Style="{StaticResource HelperTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
