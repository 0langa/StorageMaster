<Page
    x:Class="StorageMaster.UI.Pages.DuplicatesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:models="using:StorageMaster.Core.Models"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    AutomationProperties.Name="{i18n:Loc Key=Duplicates_Page_Automation}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:FilePathToBitmapImageConverter x:Key="FilePathToImage" />
    </Page.Resources>

    <!-- The content below the command bar scrolls as one surface. Star-sized
         panels used to starve to zero height on short logical viewports
         (e.g. 200% display scale), leaving member rows and quarantine restore
         buttons without usable bounds; the lists carry Min/MaxHeights instead
         and scroll internally. -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Refresh"
                          Label="{i18n:Loc Key=Duplicates_Command_Run}"
                          Command="{x:Bind ViewModel.RunAnalysisCommand}"
                          IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" />
            <AppBarButton Icon="Cancel"
                          Label="{i18n:Loc Key=Duplicates_Command_Cancel}"
                          Command="{x:Bind ViewModel.CancelAnalysisCommand}"
                          IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
            <AppBarButton Icon="Delete"
                          Label="{i18n:Loc Key=Safety_Duplicates_DeleteSelected}"
                          Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                          IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}" />
            <CommandBar.Content>
                <controls:PageHeader Title="{i18n:Loc Key=Duplicates_Title}"
                                     Subtitle="{i18n:Loc Key=Duplicates_Subtitle}" />
            </CommandBar.Content>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="SelectAll"
                              Label="{i18n:Loc Key=Duplicates_Command_SelectSafeExact}"
                              Command="{x:Bind ViewModel.SelectSafeExactDuplicatesOnPageCommand}"
                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                <AppBarButton Icon="ClearSelection"
                              Label="{i18n:Loc Key=Duplicates_Command_DeselectPage}"
                              Command="{x:Bind ViewModel.DeselectCurrentPageCommand}"
                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton Icon="Save"
                              Label="{i18n:Loc Key=Duplicates_Command_ExportCsv}"
                              Command="{x:Bind ViewModel.ExportCsvCommand}" />
                <AppBarButton Icon="SaveLocal"
                              Label="{i18n:Loc Key=Duplicates_Command_ExportJson}"
                              Command="{x:Bind ViewModel.ExportJsonCommand}" />
                <AppBarButton Icon="Document"
                              Label="{i18n:Loc Key=Duplicates_Command_ExportHtml}"
                              Command="{x:Bind ViewModel.ExportHtmlCommand}" />
                <AppBarButton Icon="Cancel"
                              Label="{i18n:Loc Key=Duplicates_Command_CancelExport}"
                              Command="{x:Bind ViewModel.CancelExportCommand}"
                              IsEnabled="{x:Bind ViewModel.CanCancelExport, Mode=OneWay}" />
                <AppBarButton Icon="OpenFile"
                              Label="{i18n:Loc Key=Duplicates_Command_OpenExportFolder}"
                              Command="{x:Bind ViewModel.OpenExportFolderCommand}"
                              IsEnabled="{x:Bind ViewModel.CanOpenExportFolder, Mode=OneWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="{i18n:Loc Key=Safety_Duplicates_InfoBar_Title}"
                     Message="{i18n:Loc Key=Safety_Duplicates_InfoBar_Message}" />

        <Border Style="{StaticResource SectionCardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock Text="{i18n:Loc Key=Duplicates_StartAnalysis_Header}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LatestRunSummary, Mode=OneWay}"
                                   Style="{StaticResource HelperTextStyle}"
                                   
                                   TextWrapping="WrapWholeWords" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Header="{i18n:Loc Key=Duplicates_ScanSession_Header}"
                                  ItemsSource="{x:Bind ViewModel.Sessions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSession, Mode=OneWay}"
                                  DisplayMemberPath="RootPath" />

                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Header="{i18n:Loc Key=Duplicates_FileType_Header}"
                                  ItemsSource="{x:Bind ViewModel.CategoryOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />

                        <NumberBox Grid.Row="0" Grid.Column="2"
                                   Header="{i18n:Loc Key=Duplicates_MinSize_Header}"
                                   Minimum="0"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.MinimumSizeMb, Mode=TwoWay}" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  Header="{i18n:Loc Key=Duplicates_Scope_Header}"
                                  ItemsSource="{x:Bind ViewModel.ScopeModeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedScopeMode, Mode=TwoWay}" />

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Header="{i18n:Loc Key=Duplicates_KeeperPolicy_Header}"
                                  ItemsSource="{x:Bind ViewModel.KeeperPolicyOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.KeeperPolicy, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.ScopeHelpText, Mode=OneWay}"
                                   Style="{StaticResource HelperTextStyle}"
                                   
                                   TextWrapping="WrapWholeWords" />

                        <Expander Header="{i18n:Loc Key=Duplicates_ScopeFilters_Header}">
                            <StackPanel Spacing="12" Padding="0,12,0,0">
                                <TextBox Header="{i18n:Loc Key=Duplicates_IncludedFolders_Header}"
                                         PlaceholderText="{i18n:Loc Key=Duplicates_PathList_Placeholder}"
                                         AcceptsReturn="True"
                                         Visibility="{x:Bind ViewModel.IsIncludedScopeMode, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                         Text="{x:Bind ViewModel.ScopePathsText, Mode=TwoWay}" />

                                <TextBox Header="{i18n:Loc Key=Duplicates_ExcludedFolders_Header}"
                                         PlaceholderText="{i18n:Loc Key=Duplicates_PathList_Placeholder}"
                                         AcceptsReturn="True"
                                         Visibility="{x:Bind ViewModel.IsExcludedScopeMode, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                         Text="{x:Bind ViewModel.ExcludedScopePathsText, Mode=TwoWay}" />

                                <TextBox Header="{i18n:Loc Key=Duplicates_CustomExtensions_Header}"
                                         PlaceholderText="{i18n:Loc Key=Duplicates_CustomExtensions_Placeholder}"
                                         Visibility="{x:Bind ViewModel.IsCustomCategorySelected, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                         Text="{x:Bind ViewModel.CustomExtensionsText, Mode=TwoWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="{i18n:Loc Key=Duplicates_MatchMethods_Header}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Border Style="{StaticResource SubtleCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{i18n:Loc Key=Duplicates_ExactAlwaysOn}"
                                           FontWeight="SemiBold" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Method_TextDocuments_Header}"
                                              IsOn="{x:Bind ViewModel.IncludeNormalizedText, Mode=TwoWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Method_SimilarImages_Header}"
                                              IsOn="{x:Bind ViewModel.IncludeImagePHash, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.IsImagePHashAvailable, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.ImageMethodSummary, Mode=OneWay}"
                                           Style="{StaticResource HelperTextStyle}"
                                           
                                           TextWrapping="WrapWholeWords" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Method_SimilarVideos_Header}"
                                              IsOn="{x:Bind ViewModel.IncludeVideoPHash, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.IsVideoPHashAvailable, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.VideoMethodSummary, Mode=OneWay}"
                                           Style="{StaticResource HelperTextStyle}"
                                           
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Expander Header="{i18n:Loc Key=Duplicates_AdvancedOptions_Header}">
                            <StackPanel Spacing="10" Padding="0,12,0,0">
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_IncludeHidden_Header}"
                                              IsOn="{x:Bind ViewModel.IncludeHiddenFiles, Mode=TwoWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_IncludeReparsePoints_Header}"
                                              IsOn="{x:Bind ViewModel.IncludeReparsePoints, Mode=TwoWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Safety_Duplicates_UseRecycleBin}"
                                              IsOn="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Safety_Duplicates_UseQuarantine}"
                                              IsOn="{x:Bind ViewModel.UseQuarantine, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.DeleteModeSummary, Mode=OneWay}"
                                           Style="{StaticResource HelperTextStyle}"
                                           
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0"
                                  IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                  Width="22"
                                  Height="22" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource HelperTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ExportStatusText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Four readouts on one baseline: label above value, same weight. -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Loc Key=Duplicates_Metric_GroupsFound}" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalGroupCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Loc Key=Duplicates_Metric_SafeExact}" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ExactGroupCount, Mode=OneWay}"
                               Style="{StaticResource MetricTextStyle}"
                               Foreground="{StaticResource SmSeverityHealthyTextBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Loc Key=Duplicates_Metric_NeedsReview}" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReviewGroupCount, Mode=OneWay}"
                               Style="{StaticResource MetricTextStyle}"
                               Foreground="{StaticResource SmSeverityWarningTextBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Loc Key=Duplicates_Metric_Reclaimable}" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReclaimableText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 PlaceholderText="{i18n:Loc Key=Duplicates_Search_Placeholder}"
                                 IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Content="{i18n:Loc Key=Duplicates_Page_Previous}"
                                Command="{x:Bind ViewModel.PreviousGroupsPageCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadPreviousGroups, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="{i18n:Loc Key=Duplicates_Page_Next}"
                                Command="{x:Bind ViewModel.NextGroupsPageCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadNextGroups, Mode=OneWay}" />
                    </Grid>

                    <Expander Grid.Row="1"
                              Header="{i18n:Loc Key=Duplicates_MoreFilters_Header}"
                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Header="{i18n:Loc Key=Duplicates_Sort_Header}"
                                          ItemsSource="{x:Bind ViewModel.GroupSortOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.GroupSortBy, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1"
                                           Header="{i18n:Loc Key=Duplicates_MinConfidence_Header}"
                                           Minimum="0"
                                           Maximum="1"
                                           SmallChange="0.1"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.MinimumConfidenceFilter, Mode=TwoWay}" />
                                <ComboBox Grid.Column="2"
                                          Header="{i18n:Loc Key=Duplicates_MethodFilter_Header}"
                                          ItemsSource="{x:Bind ViewModel.MethodFilterOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMethodFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Filter_SelectedOnly}"
                                              IsOn="{x:Bind ViewModel.FilterSelectedOnly, Mode=TwoWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Filter_MissingOnly}"
                                              IsOn="{x:Bind ViewModel.FilterMissingOnly, Mode=TwoWay}" />
                                <ToggleSwitch Header="{i18n:Loc Key=Duplicates_Filter_ErroredOnly}"
                                              IsOn="{x:Bind ViewModel.FilterErroredOnly, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.Groups}"
                              SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}"
                              SelectionMode="Single"
                              MinHeight="160"
                              MaxHeight="520">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DuplicateGroupItem">
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind MethodText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ConfidenceText}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind BadgeText}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind PathSummary}"
                                                   Style="{StaticResource HelperTextStyle}" />
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Text="{x:Bind MemberCountText}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ReclaimableSummaryText}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SelectedCountText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ViewModel.SelectedGroup.MethodText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedGroup.BadgeText, Mode=OneWay}"
                                           Style="{StaticResource HelperTextStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Header="{i18n:Loc Key=Duplicates_KeeperPolicy_Header}"
                                      Margin="8,0,0,0"
                                      ItemsSource="{x:Bind ViewModel.KeeperPolicyOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.KeeperPolicy, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.PreviewSummary, Mode=OneWay}"
                                   Style="{StaticResource HelperTextStyle}" />

                        <!--
                            ItemsRepeater, not ItemsControl: an ItemsControl never
                            virtualises, so selecting an exact-duplicate group of a
                            few hundred identical photos opened and decoded every
                            one of them at once. A repeater inside this scroller
                            realises only the previews actually on screen.
                        -->
                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      MaxHeight="160"
                                      Visibility="{x:Bind ViewModel.HasPreviewItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicatePreviewItem">
                                        <Border Style="{StaticResource SubtleCardStyle}"
                                                Padding="8" Width="180">
                                            <StackPanel Spacing="4">
                                                <Image Source="{x:Bind PreviewPath, Converter={StaticResource FilePathToImage}}"
                                                       MaxHeight="100" Stretch="Uniform" />
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2" />
                                                <TextBlock Text="{x:Bind Subtitle}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="3"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <ListView Grid.Row="3"
                                  ItemsSource="{x:Bind ViewModel.SelectedGroup.Members, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.CanModifyDeletionPlan, Mode=OneWay}"
                                  SelectionMode="None"
                                  MinHeight="120"
                                  MaxHeight="320"
                                  Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DuplicateMemberItem">
                                    <!--
                                        Fixed value columns, not Auto: with Auto every
                                        row measured itself and the sizes zig-zagged
                                        down the list instead of forming a column the
                                        eye can compare.
                                    -->
                                    <Grid ColumnDefinitions="Auto,*,110,110,150" ColumnSpacing="10">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsKeeper, Converter={StaticResource NotBool}}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Member.FileName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Member.FullPath}" Style="{StaticResource PathTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" Style="{StaticResource ColumnHeaderTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource MetricColumnTextStyle}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText}" Style="{StaticResource ColumnHeaderNumericTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="3"
                                   Text="{i18n:Loc Key=Duplicates_Members_EmptyState}"
                                   Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource NotBoolVis}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind ViewModel.ErrorSummary, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Errors}"
                                  MaxHeight="180"
                                  Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicateError">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ErrorType}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource HelperTextStyle}" />
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="2"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Content="{i18n:Loc Key=Duplicates_Errors_LoadMore}"
                                Command="{x:Bind ViewModel.LoadMoreErrorsCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadMoreErrors, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}"
                        Visibility="{x:Bind ViewModel.HasQuarantineItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{i18n:Loc Key=Safety_Duplicates_Quarantine_Header}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{i18n:Loc Key=Safety_Duplicates_Quarantine_Description}"
                                   Style="{StaticResource MutedTextStyle}"
                                    />
                        <ListView ItemsSource="{x:Bind ViewModel.QuarantineItems, Mode=OneWay}"
                                  MaxHeight="150"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QuarantinedFile">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind OriginalPath}"
                                                       TextWrapping="WrapWholeWords" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind QuarantinedUtc}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                            />
                                                <TextBlock Text="{x:Bind local:DuplicatesPage.DescribeQuarantineSource(MemberId)}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                            />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{i18n:Loc Key=Safety_Duplicates_Restore}"
                                                VerticalAlignment="Center"
                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.RestoreQuarantinedCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
