<Page
    x:Class="StorageMaster.UI.Pages.DuplicatesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:models="using:StorageMaster.Core.Models"
    xmlns:converters="using:StorageMaster.UI.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:FilePathToBitmapImageConverter x:Key="FilePathToImage" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh"
                          Label="Run"
                          Command="{x:Bind ViewModel.RunAnalysisCommand}"
                          IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" />
            <AppBarButton Icon="Cancel"
                          Label="Cancel"
                          Command="{x:Bind ViewModel.CancelAnalysisCommand}"
                          IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
            <AppBarButton Icon="Delete"
                          Label="Delete selected"
                          Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                          IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}" />
            <AppBarButton Icon="SelectAll"
                          Label="Select safe exact"
                          Command="{x:Bind ViewModel.SelectSafeExactDuplicatesCommand}" />
            <AppBarButton Icon="ClearSelection"
                          Label="Deselect all"
                          Command="{x:Bind ViewModel.DeselectAllCommand}" />
            <AppBarButton Icon="Save"
                          Label="Export CSV"
                          Command="{x:Bind ViewModel.ExportCsvCommand}" />
            <AppBarButton Icon="SaveLocal"
                          Label="Export JSON"
                          Command="{x:Bind ViewModel.ExportJsonCommand}" />
            <AppBarButton Icon="Document"
                          Label="Export HTML"
                          Command="{x:Bind ViewModel.ExportHtmlCommand}" />
            <CommandBar.Content>
                <TextBlock Text="Deduplicate"
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           VerticalAlignment="Center" />
            </CommandBar.Content>
        </CommandBar>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Scope and methods"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0" Grid.Column="0"
                              Header="Scan session"
                              ItemsSource="{x:Bind ViewModel.Sessions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                              DisplayMemberPath="RootPath" />

                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Header="Scope mode"
                              ItemsSource="{x:Bind ViewModel.ScopeModeOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedScopeMode, Mode=TwoWay}" />

                    <ComboBox Grid.Row="0" Grid.Column="2"
                              Header="File type"
                              ItemsSource="{x:Bind ViewModel.CategoryOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                              DisplayMemberPath="Label" />

                    <NumberBox Grid.Row="0" Grid.Column="3"
                               Header="Min size (MB)"
                               Minimum="0"
                               SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind ViewModel.MinimumSizeMb, Mode=TwoWay}" />

                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Header="Included folders"
                             PlaceholderText="One path per line. Used when scope mode = IncludedFolders."
                             AcceptsReturn="True"
                             Text="{x:Bind ViewModel.ScopePathsText, Mode=TwoWay}" />

                    <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                             Header="Excluded folders"
                             PlaceholderText="One path per line. Combined with global excluded paths when scope mode = ExcludedFolders."
                             AcceptsReturn="True"
                             Text="{x:Bind ViewModel.ExcludedScopePathsText, Mode=TwoWay}" />

                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Header="Custom extensions"
                             PlaceholderText=".jpg,.png,.mp4,.pdf"
                             Text="{x:Bind ViewModel.CustomExtensionsText, Mode=TwoWay}" />

                    <ComboBox Grid.Row="2" Grid.Column="2"
                              Header="Keeper policy"
                              ItemsSource="{x:Bind ViewModel.KeeperPolicyOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.KeeperPolicy, Mode=TwoWay}" />

                    <StackPanel Grid.Row="2" Grid.Column="3" Spacing="8">
                        <ToggleSwitch Header="Recycle Bin"
                                      IsOn="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}" />
                        <ToggleSwitch Header="Quarantine"
                                      IsOn="{x:Bind ViewModel.UseQuarantine, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch Header="Normalized text"
                                  IsOn="{x:Bind ViewModel.IncludeNormalizedText, Mode=TwoWay}" />
                    <ToggleSwitch Header="Image pHash"
                                  IsOn="{x:Bind ViewModel.IncludeImagePHash, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsImagePHashAvailable, Mode=OneWay}" />
                    <ToggleSwitch Header="Video pHash"
                                  IsOn="{x:Bind ViewModel.IncludeVideoPHash, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsVideoPHashAvailable, Mode=OneWay}" />
                    <ToggleSwitch Header="Hidden/system"
                                  IsOn="{x:Bind ViewModel.IncludeHiddenFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Reparse points"
                                  IsOn="{x:Bind ViewModel.IncludeReparsePoints, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ProviderSummary, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.85" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                  Width="24"
                                  Height="24" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Groups" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalGroupCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Exact" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ExactGroupCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Review required" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReviewGroupCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Reclaimable" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReclaimableText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10"
                    Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 PlaceholderText="Search filename or path"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Content="Previous"
                                Command="{x:Bind ViewModel.PreviousGroupsPageCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadPreviousGroups, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="Next"
                                Command="{x:Bind ViewModel.NextGroupsPageCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadNextGroups, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <ComboBox Width="180"
                                  Header="Sort"
                                  ItemsSource="{x:Bind ViewModel.GroupSortOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.GroupSortBy, Mode=TwoWay}" />
                        <NumberBox Width="160"
                                   Header="Min confidence"
                                   Minimum="0"
                                   Maximum="1"
                                   SmallChange="0.1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.MinimumConfidenceFilter, Mode=TwoWay}" />
                        <ComboBox Width="160"
                                  Header="Method"
                                  ItemsSource="{x:Bind ViewModel.MethodFilterOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMethodFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />
                        <ToggleSwitch Header="Selected only"
                                      IsOn="{x:Bind ViewModel.FilterSelectedOnly, Mode=TwoWay}" />
                        <ToggleSwitch Header="Missing only"
                                      IsOn="{x:Bind ViewModel.FilterMissingOnly, Mode=TwoWay}" />
                        <ToggleSwitch Header="Errored only"
                                      IsOn="{x:Bind ViewModel.FilterErroredOnly, Mode=TwoWay}" />
                    </StackPanel>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.Groups}"
                              SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DuplicateGroupItem">
                                <Border Padding="10" Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind MethodText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ConfidenceText}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind BadgeText}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind PathSummary}"
                                                   TextWrapping="WrapWholeWords"
                                                   Opacity="0.72" />
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Text="{x:Bind MemberCount}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TotalSizeText}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ReclaimableText}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind SelectedCount}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ViewModel.SelectedGroup.MethodText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedGroup.BadgeText, Mode=OneWay}" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Content="Keep newest"
                                    Command="{x:Bind ViewModel.KeepNewestCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Content="Keep oldest"
                                    Command="{x:Bind ViewModel.KeepOldestCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Content="Keep shortest path"
                                    Command="{x:Bind ViewModel.KeepShortestPathCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}" />
                            <Button Grid.Column="4"
                                    Margin="8,0,0,0"
                                    Content="Keep longest path"
                                    Command="{x:Bind ViewModel.KeepLongestPathCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedGroup, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.PreviewSummary, Mode=OneWay}"
                                   Opacity="0.7"
                                   TextWrapping="WrapWholeWords" />

                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      MaxHeight="160"
                                      Visibility="{x:Bind ViewModel.HasPreviewItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicatePreviewItem">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="6" Padding="8" MaxWidth="200">
                                            <StackPanel Spacing="4">
                                                <Image Source="{x:Bind PreviewPath, Converter={StaticResource FilePathToImage}}"
                                                       MaxHeight="100" Stretch="Uniform" />
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2" />
                                                <TextBlock Text="{x:Bind Subtitle}"
                                                           Opacity="0.7"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="3"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ListView Grid.Row="3"
                                  ItemsSource="{x:Bind ViewModel.SelectedGroup.Members, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DuplicateMemberItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsKeeper, Converter={StaticResource NotBool}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Member.FileName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Member.FullPath}" Opacity="0.7" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="3"
                                   Text="Select a group to review members."
                                   Visibility="{x:Bind ViewModel.HasSelectedGroup, Mode=OneWay, Converter={StaticResource NotBoolVis}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind ViewModel.ErrorSummary, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Errors}"
                                  Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay, Converter={StaticResource BoolVis}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DuplicateError">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ErrorType}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" TextWrapping="WrapWholeWords" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="2"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Content="Load more"
                                Command="{x:Bind ViewModel.LoadMoreErrorsCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLoadMoreErrors, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="12"
                        Visibility="{x:Bind ViewModel.HasQuarantineItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quarantine — restorable files"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.QuarantineItems, Mode=OneWay}"
                                  MaxHeight="150"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QuarantinedFile">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind OriginalPath}"
                                                       TextWrapping="WrapWholeWords"
                                                       Opacity="0.9" />
                                            <TextBlock Text="{x:Bind QuarantinedUtc}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Restore"
                                                VerticalAlignment="Center"
                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.RestoreQuarantinedCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
