<Page
    x:Class="StorageMaster.UI.Pages.ResultsPage"
    x:Name="PageRoot"
    AutomationProperties.Name="{i18n:Loc Key=Results_Page_AutomationName}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
    </Page.Resources>

    <Grid>
        <!-- Loading overlay -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolVis}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" Height="64"/>

        <ScrollViewer Padding="{StaticResource PagePaddingWide}">
            <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">

                <controls:PageHeader Title="{i18n:Loc Key=Results_Title}"
                                     Subtitle="{x:Bind ViewModel.ScanRoot, Mode=OneWay}">
                    <controls:PageHeader.ActionContent>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TightSpacing}">
                            <Button Content="{StaticResource IconDelete}"
                                    Style="{StaticResource IconCommandButtonStyle}"
                                    ToolTipService.ToolTip="{i18n:Loc Key=Safety_DeleteScanFromHistory}"
                                    AutomationProperties.Name="{i18n:Loc Key=Safety_DeleteScanFromHistory}"
                                    Command="{x:Bind ViewModel.DeleteSessionCommand}" />
                            <Button Content="{i18n:Loc Key=Results_OpenWorkspace}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinHeight="36"
                                    Command="{x:Bind ViewModel.OpenWorkspaceCommand}"
                                    ToolTipService.ToolTip="{i18n:Loc Key=Results_OpenWorkspace_Tooltip}" />
                        </StackPanel>
                    </controls:PageHeader.ActionContent>
                </controls:PageHeader>

                <InfoBar IsOpen="True"
                         Severity="Informational"
                         Title="{i18n:Loc Key=Results_SessionNote_Title}"
                         Message="{x:Bind ViewModel.SessionNote, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasSessionNote, Mode=OneWay, Converter={StaticResource BoolVis}}" />

                <Border Style="{StaticResource SectionCardStyle}"
                        Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource InvBoolVis}}">
                    <StackPanel Spacing="{StaticResource TightSpacing}">
                        <TextBlock Text="{i18n:Loc Key=Results_Empty_Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{i18n:Loc Key=Results_Empty_Body}"
                                   Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Summary: four readouts on one baseline. -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource ControlSpacing}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{i18n:Loc Key=Results_Summary_ScanRoot}" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanRoot, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{i18n:Loc Key=Results_Summary_Date}" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanDate, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{i18n:Loc Key=Results_Summary_TotalSize}" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalSize, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="{i18n:Loc Key=Results_Summary_Files}" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter with debounce, clear button, and result count -->
                <StackPanel Spacing="4" MaxWidth="480" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource TightSpacing}">
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 PlaceholderText="{i18n:Loc Key=Results_Filter_Placeholder}"
                                 Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1"
                                Content="{StaticResource IconClear}"
                                Style="{StaticResource IconCommandButtonStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{i18n:Loc Key=Results_ClearFilter}"
                                AutomationProperties.Name="{i18n:Loc Key=Results_ClearFilter}"
                                Command="{x:Bind ViewModel.ClearFilterCommand}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.FilterCountLabel, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource TightSpacing}"
                                Visibility="{x:Bind ViewModel.HasCategoryFilter, Mode=OneWay, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{i18n:Loc Key=Results_CategoryFilterActive}"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center"/>
                        <HyperlinkButton Content="{i18n:Loc Key=Results_ClearCategoryFilter}"
                                         Command="{x:Bind ViewModel.ClearCategoryFilterCommand}"
                                         Padding="0" />
                    </StackPanel>
                </StackPanel>

                <!-- Pivot for tabs -->
                <Pivot x:Name="ResultsPivot"
                       SelectionChanged="ResultsPivot_SelectionChanged">

                    <!-- Largest Files -->
                    <PivotItem Header="{i18n:Loc Key=Results_Tab_LargestFiles}">
                        <StackPanel>
                            <!--
                                Bounded on purpose. The page root is a ScrollViewer,
                                so a list left unbounded is measured with an infinite
                                viewport, culls nothing and realises every row of a
                                paged result set in one UI-thread pass. Cleanup and
                                Duplicates already cap their lists; these were the
                                remaining unbounded ones.
                            -->
                            <ListView ItemsSource="{x:Bind ViewModel.LargestFiles}"
                                      SelectionMode="None" Margin="0,8,0,0"
                                      MinHeight="{StaticResource ListMinHeight}"
                                      MaxHeight="{StaticResource ListMaxHeightTall}">
                                <ListView.Header>
                                    <!-- Sortable column headers — click a column name to sort;
                                         click again to toggle direction. ▼/▲ shows active sort. -->
                                    <!--
                                        The Type column is wide enough for the longest
                                        category label ("Executable"); at 120 it was
                                        clipped by the action buttons beside it.
                                    -->
                                    <Grid ColumnDefinitions="*,130,140,150,40,40" Padding="4,2">
                                        <TextBlock Grid.Column="0" Text="{i18n:Loc Key=Results_Column_File}" Style="{StaticResource ColumnHeaderTextStyle}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ViewModel.FileSizeHeader, ElementName=PageRoot}"
                                                Command="{Binding ViewModel.SortFilesByCommand, ElementName=PageRoot}"
                                                CommandParameter="Size"
                                                Style="{StaticResource ColumnSortButtonStyle}"/>
                                        <Button Grid.Column="2"
                                                Content="{Binding ViewModel.FileModifiedHeader, ElementName=PageRoot}"
                                                Command="{Binding ViewModel.SortFilesByCommand, ElementName=PageRoot}"
                                                CommandParameter="Modified"
                                                Style="{StaticResource ColumnSortButtonStyle}"/>
                                        <Button Grid.Column="3"
                                                Content="{Binding ViewModel.FileTypeHeader, ElementName=PageRoot}"
                                                Command="{Binding ViewModel.SortFilesByCommand, ElementName=PageRoot}"
                                                CommandParameter="Type"
                                                Style="{StaticResource ColumnSortButtonStyle}"/>
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,130,140,150,40,40" Padding="0,4">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="{i18n:Loc Key=Results_CopyFullPath}"
                                                                    Command="{Binding ViewModel.CopyFilePathCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{i18n:Loc Key=Results_OpenInExplorer}"
                                                                    Command="{Binding ViewModel.OpenInExplorerCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator/>
                                                    <MenuFlyoutItem Text="{i18n:Loc Key=Safety_SendToRecycleBin}"
                                                                    Command="{Binding ViewModel.DeleteFileCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ParentPath}"
                                                           Style="{StaticResource PathTextStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}"
                                                       Style="{StaticResource MetricColumnTextStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ModifiedUtc}"
                                                       Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Category}"
                                                       Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                            <Button Grid.Column="4"
                                                    Content="{StaticResource IconOpenInExplorer}"
                                                    Style="{StaticResource IconCommandButtonStyle}"
                                                    MinWidth="32" MinHeight="32" Padding="0"
                                                    ToolTipService.ToolTip="{i18n:Loc Key=Results_OpenContainingFolder}"
                                                    AutomationProperties.Name="{i18n:Loc Key=Results_OpenContainingFolder}"
                                                    Command="{Binding ViewModel.OpenInExplorerCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"/>
                                            <Button Grid.Column="5"
                                                    Content="{StaticResource IconDelete}"
                                                    Style="{StaticResource IconCommandButtonStyle}"
                                                    MinWidth="32" MinHeight="32" Padding="0"
                                                    ToolTipService.ToolTip="{i18n:Loc Key=Safety_SendToRecycleBin}"
                                                    AutomationProperties.Name="{i18n:Loc Key=Safety_SendToRecycleBin}"
                                                    Command="{Binding ViewModel.DeleteFileCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="{i18n:Loc Key=Results_LoadMoreFiles}"
                                    Style="{StaticResource CommandButtonStyle}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.LoadMoreFilesCommand}"
                                    Visibility="{x:Bind ViewModel.CanLoadMoreFiles, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </PivotItem>

                    <!-- Largest Folders -->
                    <PivotItem Header="{i18n:Loc Key=Results_Tab_LargestFolders}">
                        <StackPanel>
                            <ListView ItemsSource="{x:Bind ViewModel.LargestFolders}"
                                      SelectionMode="None" Margin="0,8,0,0"
                                      MinHeight="{StaticResource ListMinHeight}"
                                      MaxHeight="{StaticResource ListMaxHeightTall}">
                                <ListView.Header>
                                    <Grid ColumnDefinitions="*,130,100,36" Padding="4,2">
                                        <TextBlock Grid.Column="0" Text="{i18n:Loc Key=Results_Column_Folder}" Style="{StaticResource ColumnHeaderTextStyle}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ViewModel.FolderSizeHeader, ElementName=PageRoot}"
                                                Command="{Binding ViewModel.SortFoldersByCommand, ElementName=PageRoot}"
                                                CommandParameter="Size"
                                                Style="{StaticResource ColumnSortButtonStyle}"/>
                                        <Button Grid.Column="2"
                                                Content="{Binding ViewModel.FolderFilesHeader, ElementName=PageRoot}"
                                                Command="{Binding ViewModel.SortFoldersByCommand, ElementName=PageRoot}"
                                                CommandParameter="Files"
                                                Style="{StaticResource ColumnSortButtonStyle}"/>
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,130,100,36" Padding="0,4">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="{i18n:Loc Key=Results_CopyFullPath}"
                                                                    Command="{Binding ViewModel.CopyFolderPathCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{i18n:Loc Key=Results_OpenInExplorer}"
                                                                    Command="{Binding ViewModel.OpenFolderInExplorerCommand, ElementName=PageRoot}"
                                                                    CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;"/></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FullPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalSizeBytes, Converter={StaticResource ByteSize}}"
                                                       Style="{StaticResource MetricColumnTextStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileCount}"
                                                       Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                            <Button Grid.Column="3"
                                                    Content="{StaticResource IconOpenInExplorer}"
                                                    Style="{StaticResource IconCommandButtonStyle}"
                                                    MinWidth="32" MinHeight="32" Padding="0"
                                                    ToolTipService.ToolTip="{i18n:Loc Key=Results_OpenInExplorer}"
                                                    AutomationProperties.Name="{i18n:Loc Key=Results_OpenInExplorer}"
                                                    Command="{Binding ViewModel.OpenFolderInExplorerCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="{i18n:Loc Key=Results_LoadMoreFolders}"
                                    Style="{StaticResource CommandButtonStyle}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.LoadMoreFoldersCommand}"
                                    Visibility="{x:Bind ViewModel.CanLoadMoreFolders, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </PivotItem>

                    <!-- File Types -->
                    <PivotItem Header="{i18n:Loc Key=Results_Tab_FileTypes}">
                        <ListView ItemsSource="{x:Bind ViewModel.CategoryBreakdown}"
                                  SelectionMode="None" Margin="0,8,0,0"
                                  MaxHeight="{StaticResource ListMaxHeightTall}">
                            <ListView.Header>
                                <Grid ColumnDefinitions="*,120,80" Padding="12,4">
                                    <TextBlock Grid.Column="0" Text="{i18n:Loc Key=Results_Column_Category}" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{i18n:Loc Key=Results_Column_TotalSize}" Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{i18n:Loc Key=Results_Column_Files}" Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,120,80" Padding="0,4">
                                        <Button Grid.Column="0"
                                                Content="{Binding Category}"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{Binding ViewModel.FilterByCategoryCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSize}"
                                                   Style="{StaticResource MetricColumnTextStyle}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FileCount}"
                                                   Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </PivotItem>

                    <!-- Errors -->
                    <PivotItem x:Name="ErrorsPivotItem">
                        <PivotItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{i18n:Loc Key=Results_Tab_Errors}"/>
                                <Border BorderBrush="{StaticResource SmSeverityCriticalTextBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ChipCornerRadius}" Padding="6,1"
                                        Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SmSeverityCriticalTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </PivotItem.Header>
                        <StackPanel Spacing="{StaticResource TightSpacing}">
                            <TextBlock Text="{x:Bind ViewModel.ErrorsStatusText, Mode=OneWay}"
                                       Style="{StaticResource HelperTextStyle}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsErrorsLoading, Mode=OneWay}"
                                          Width="20"
                                          Height="20"
                                          Visibility="{x:Bind ViewModel.IsErrorsLoading, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        <ListView ItemsSource="{x:Bind ViewModel.ScanErrors}"
                                  SelectionMode="None" Margin="0,8,0,0"
                                  MaxHeight="{StaticResource ListMaxHeightTall}">
                            <ListView.Header>
                                <Grid ColumnDefinitions="*,140,200" Padding="12,4">
                                    <TextBlock Grid.Column="0" Text="{i18n:Loc Key=Results_Column_Path}" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{i18n:Loc Key=Results_Column_ErrorType}" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{i18n:Loc Key=Results_Column_Message}" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,140,200" Padding="0,4">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Path}"
                                                   Style="{StaticResource PathTextStyle}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ErrorType}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SmSeverityWarningTextBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </StackPanel>
                    </PivotItem>

                    <!-- Folder Tree -->
                    <PivotItem x:Name="FolderTreePivotItem" Header="{i18n:Loc Key=Results_Tab_FolderTree}">
                        <StackPanel Spacing="{StaticResource TightSpacing}" Margin="0,8,0,0">
                            <TextBlock Text="{x:Bind ViewModel.FolderTreeStatusText, Mode=OneWay}"
                                       Style="{StaticResource HelperTextStyle}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsFolderTreeLoading, Mode=OneWay}"
                                          Width="20"
                                          Height="20"
                                          Visibility="{x:Bind ViewModel.IsFolderTreeLoading, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                            <TreeView x:Name="FolderTreeControl"
                                      Expanding="FolderTreeControl_Expanding"
                                      SelectionMode="None"
                                      MinHeight="{StaticResource ListMinHeight}"
                                      MaxHeight="{StaticResource ListMaxHeightTall}">
                                <TreeView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- DataContext here is TreeViewNode; Content is FolderTreeNode -->
                                        <Grid ColumnDefinitions="*,120,80">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Content.DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Content.SizeText}"
                                                       Style="{StaticResource MetricColumnTextStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Content.FileCountText}"
                                                       Style="{StaticResource ColumnHeaderNumericTextStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </PivotItem>

                </Pivot>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
