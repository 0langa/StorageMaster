<Page
    x:Class="StorageMaster.UI.Pages.ScanPage"
    AutomationProperties.Name="Scan page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">

            <!--
                One piece of wayfinding, not two. The page used to carry both this
                "Step 3 of 4 · Run scan" line and a static 1/2/3/4 card row lower
                down that never highlighted the step you were actually on, so the
                inert copy was removed and the live one kept.

                Start Scan is the page's single primary action and lives in the
                header, where every other page puts its primary action.
            -->
            <controls:PageHeader Title="Scan"
                                 Subtitle="{x:Bind ViewModel.ScanStepText, Mode=OneWay}">
                <controls:PageHeader.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <Button Content="Cancel"
                                Style="{StaticResource CommandButtonStyle}"
                                Command="{x:Bind ViewModel.CancelScanCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        <Button Content="View Results"
                                Style="{StaticResource CommandButtonStyle}"
                                Command="{x:Bind ViewModel.ViewResultsCommand}"
                                Visibility="{x:Bind ViewModel.ScanComplete, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        <Button Content="Start Scan"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.StartScanCommand}"
                                IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}" />
                    </StackPanel>
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <StackPanel Spacing="{StaticResource CardSpacing}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}"
                                       Style="{StaticResource PathTextStyle}" />
                        </StackPanel>
                        <ProgressRing Grid.Column="1" IsActive="True" Width="44" Height="44" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                 Maximum="100" Height="8" />
                    <!--
                        Eight live readouts on one grid: label above value, same
                        size and weight throughout, so the eye can compare a
                        column rather than re-reading each cell.
                    -->
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource ControlSpacing}" RowSpacing="{StaticResource ControlSpacing}"
                          Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Files" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.FilesScanned, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Folders" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.FoldersScanned, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Size" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BytesScanned, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Errors" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Speed" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanSpeed, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="Elapsed" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                            <TextBlock Text="File rate" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanFileRate, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="2">
                            <TextBlock Text="ETA" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.EstimatedRemainingTime, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <TextBlock Text="Select path to scan"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource TightSpacing}">
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 PlaceholderText="e.g. C:\ or C:\Users"
                                 Text="{x:Bind ViewModel.SelectedPath, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="Browse…"
                                Style="{StaticResource CommandButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.ScanPathError, Mode=OneWay}"
                               Foreground="{StaticResource SmSeverityCriticalTextBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="WrapWholeWords"
                               Visibility="{x:Bind ViewModel.HasScanPathError, Mode=OneWay, Converter={StaticResource BoolVis}}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource PillButtonStyle}"
                                        Click="DriveButton_Click"
                                        Tag="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Step 2: the four scan modes, presented as one choice. -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource ControlSpacing}">
                <Button Grid.Column="0" Command="{x:Bind ViewModel.SelectScanModeCommand}" CommandParameter="Quick Scan"
                        IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top" Padding="14,12" MinHeight="108"
                        CornerRadius="{StaticResource TileCornerRadius}">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Quick Scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Fast metadata pass for common storage review." Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectScanModeCommand}" CommandParameter="Standard Scan"
                        IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top" Padding="14,12" MinHeight="108"
                        CornerRadius="{StaticResource TileCornerRadius}">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Standard Scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Recommended balance for routine drive scans." Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.SelectScanModeCommand}" CommandParameter="Deep Scan"
                        IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top" Padding="14,12" MinHeight="108"
                        CornerRadius="{StaticResource TileCornerRadius}">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Deep Scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Protected folders and access-denied reporting." Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{x:Bind ViewModel.SelectScanModeCommand}" CommandParameter="Custom Scan"
                        IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top" Padding="14,12" MinHeight="108"
                        CornerRadius="{StaticResource TileCornerRadius}">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Custom Scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Use current toggles and persisted exclusions." Style="{StaticResource HelperTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedScanMode, Mode=OneWay}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ToggleSwitch Header="Deep Scan"
                                  IsOn="{x:Bind ViewModel.DeepScan, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}" />
                    <TextBlock Text="Attempts protected directories, disables the default system excludes, and records access-denied errors instead of silently skipping them. Administrator mode is recommended."
                               Style="{StaticResource HelperTextStyle}" />

                    <!-- Admin status banner (only shown when deep scan is on) -->
                    <InfoBar IsOpen="True" Severity="Success"
                             Title="Running as Administrator"
                             Message="All files and system folders are accessible."
                             Visibility="{x:Bind ViewModel.IsRunningAsAdmin, Mode=OneWay, Converter={StaticResource BoolVis}}" />

                    <!-- Elevation prompt (deep scan on, not yet admin) -->
                    <Border Style="{StaticResource SubtleCardStyle}"
                            BorderBrush="{StaticResource SmSeverityWarningBrush}"
                            Visibility="{x:Bind ViewModel.NeedsElevation, Mode=OneWay, Converter={StaticResource BoolVis}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Administrator privileges recommended"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{StaticResource SmSeverityWarningTextBrush}" />
                                <TextBlock Text="Without admin rights, access-denied errors will be recorded for protected system folders. Use the button to relaunch with full privileges."
                                           Style="{StaticResource HelperTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Run as Administrator"
                                    Style="{StaticResource CommandButtonStyle}"
                                    Command="{x:Bind ViewModel.RequestElevationCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <ToggleSwitch Header="Turbo Scanner (Rust-powered)"
                                  IsOn="{x:Bind ViewModel.UseTurboScanner, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}" />
                    <TextBlock Text="Uses a native Rust engine with parallel work-stealing traversal — significantly faster on NVMe/SSD drives with many files. Falls back to the managed scanner automatically if the engine binary is not found."
                               Style="{StaticResource HelperTextStyle}" />
                    <InfoBar IsOpen="True" Severity="Warning"
                             Title="Turbo Scanner binary not found"
                             Message="turbo-scanner.exe was not found next to the application. Build from source or install a release build to enable this feature."
                             Visibility="{x:Bind ViewModel.TurboScannerAvailable, Mode=OneWay, Converter={StaticResource InvBoolVis}}" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" Severity="Success"
                     Title="Scan complete. Workspace ready."
                     Message="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.ScanComplete, Mode=OneWay, Converter={StaticResource BoolVis}}" />

            <InfoBar IsOpen="True" Severity="Error"
                     Title="Scan failed"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolVis}}" />

        </StackPanel>
    </ScrollViewer>
</Page>
