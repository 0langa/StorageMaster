<Page
    x:Class="StorageMaster.UI.Pages.ScanWorkspacePage"
    x:Name="PageRoot"
    AutomationProperties.Name="{i18n:Loc Key=Workspace_Page_AutomationName}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ByteSizeConverter x:Key="ByteSize" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Center">
            <controls:PageHeader Title="{x:Bind ViewModel.SessionTitle, Mode=OneWay}"
                                 Subtitle="{x:Bind ViewModel.SummaryText, Mode=OneWay}">
                <controls:PageHeader.ActionContent>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource ControlSpacing}">
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Key=Workspace_Metric_ScannedSize}" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSize, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Key=Workspace_Metric_Files}" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FileCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Key=Workspace_Metric_Folders}" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FolderCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{i18n:Loc Key=Workspace_Metric_Errors}" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <CommandBar DefaultLabelPosition="Right" Background="Transparent"
                        IsEnabled="{x:Bind ViewModel.CanUseSessionActions, Mode=OneWay}">
                <AppBarButton Icon="List" Label="{i18n:Loc Key=Nav_Results}" Command="{x:Bind ViewModel.OpenResultsCommand}" />
                <AppBarButton Label="{i18n:Loc Key=Nav_SpaceMap}" Command="{x:Bind ViewModel.OpenSpaceMapCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="{StaticResource IconSpaceMap}" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Copy" Label="{i18n:Loc Key=Nav_Duplicates}" Command="{x:Bind ViewModel.OpenDuplicatesCommand}" />
                <AppBarButton Icon="Delete" Label="{i18n:Loc Key=Nav_Cleanup}" Command="{x:Bind ViewModel.OpenCleanupCommand}" />
            </CommandBar>

            <TabView IsAddTabButtonVisible="False">
                <TabViewItem Header="{i18n:Loc Key=Workspace_Tab_Overview}" IsClosable="False">
                    <Grid Padding="0,16,0,0" ColumnDefinitions="1.2*,*" ColumnSpacing="{StaticResource CardSpacing}">
                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                            <StackPanel Spacing="{StaticResource ControlSpacing}">
                                <TextBlock Text="{i18n:Loc Key=Workspace_Overview_Composition}" Style="{StaticResource SectionHeaderTextStyle}" />
                                <Grid ColumnDefinitions="*,90,120" ColumnSpacing="{StaticResource ControlSpacing}">
                                    <TextBlock Grid.Column="0" Text="{i18n:Loc Key=Workspace_Column_Category}" Style="{StaticResource ColumnHeaderTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{i18n:Loc Key=Workspace_Column_Files}" Style="{StaticResource ColumnHeaderNumericTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{i18n:Loc Key=Workspace_Column_Size}" Style="{StaticResource ColumnHeaderNumericTextStyle}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryBreakdown, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,90,120" ColumnSpacing="{StaticResource ControlSpacing}" Padding="0,6">
                                                <TextBlock Grid.Column="0" Text="{Binding Category, Converter={StaticResource EnumDisplay}}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource ColumnHeaderNumericTextStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Style="{StaticResource MetricColumnTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                            <StackPanel Spacing="{StaticResource ControlSpacing}">
                                <TextBlock Text="{i18n:Loc Key=Workspace_Overview_ReviewQueue}" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DuplicateSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.ReclaimableSummary, Mode=OneWay}" Style="{StaticResource HelperTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Workspace_Tab_Files}" IsClosable="False">
                    <ListView ItemsSource="{x:Bind ViewModel.LargestFiles, Mode=OneWay}" MaxHeight="{StaticResource ListMaxHeight}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,130" ColumnSpacing="12" Padding="0,6">
                                    <TextBlock Grid.Column="0" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" Style="{StaticResource MetricColumnTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Workspace_Tab_Folders}" IsClosable="False">
                    <ListView ItemsSource="{x:Bind ViewModel.LargestFolders, Mode=OneWay}" MaxHeight="{StaticResource ListMaxHeight}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,130" ColumnSpacing="12" Padding="0,6">
                                    <TextBlock Grid.Column="0" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalSizeBytes, Converter={StaticResource ByteSize}}" Style="{StaticResource MetricColumnTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Nav_SpaceMap}" IsClosable="False">
                    <controls:StateView IconGlyph="{StaticResource IconSpaceMap}"
                                        Title="{i18n:Loc Key=Workspace_SpaceMap_Title}"
                                        Message="{i18n:Loc Key=Workspace_SpaceMap_Message}">
                        <controls:StateView.ActionContent>
                            <Button Content="{i18n:Loc Key=Workspace_SpaceMap_Action}" Command="{x:Bind ViewModel.OpenSpaceMapCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanUseSessionActions, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </controls:StateView.ActionContent>
                    </controls:StateView>
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Nav_Duplicates}" IsClosable="False">
                    <controls:StateView IconGlyph="{StaticResource IconDuplicates}"
                                        Title="{i18n:Loc Key=Workspace_Duplicates_Title}"
                                        Message="{x:Bind ViewModel.DuplicateSummary, Mode=OneWay}">
                        <controls:StateView.ActionContent>
                            <Button Content="{i18n:Loc Key=Workspace_Duplicates_Action}" Command="{x:Bind ViewModel.OpenDuplicatesCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanUseSessionActions, Mode=OneWay}" />
                        </controls:StateView.ActionContent>
                    </controls:StateView>
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Workspace_Tab_Delta}" IsClosable="False">
                    <controls:StateView IconGlyph="{StaticResource IconDelta}"
                                        Title="{i18n:Loc Key=Workspace_Delta_Title}"
                                        Message="{i18n:Loc Key=Workspace_Delta_Message}" />
                </TabViewItem>

                <TabViewItem Header="{i18n:Loc Key=Workspace_Tab_Errors}" IsClosable="False">
                    <ListView ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}" MaxHeight="{StaticResource ListMaxHeight}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,8" Spacing="3">
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource HelperTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>
            </TabView>

            <InfoBar IsOpen="True" Severity="Informational" Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
