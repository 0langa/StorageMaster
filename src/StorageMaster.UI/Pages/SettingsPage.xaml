<Page
    x:Class="StorageMaster.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <converters:BoolNegationConverter     x:Key="NotBool" />
    </Page.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="600">

            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" />

            <!-- Deletion behaviour -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Deletion Behaviour" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Send to Recycle Bin (recommended)"
                                  IsOn="{x:Bind ViewModel.PreferRecycleBin, Mode=TwoWay}" />
                    <ToggleSwitch Header="Dry-run mode by default (preview without deleting)"
                                  IsOn="{x:Bind ViewModel.DryRunByDefault, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Large / old files thresholds -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Large &amp; Old File Thresholds" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LargeFileThresholdLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <Slider Minimum="50" Maximum="5000" StepFrequency="50"
                                Value="{x:Bind ViewModel.LargeFileSizeMb, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OldFileAgeThresholdLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <Slider Minimum="30" Maximum="3650" StepFrequency="30"
                                Value="{x:Bind ViewModel.OldFileAgeDays, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scan options -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Scan Options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel>
                        <TextBlock Text="Default scan path" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{x:Bind ViewModel.DefaultScanPath, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DefaultScanPathError, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.HasDefaultScanPathError, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ScanParallelismLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <Slider Minimum="1" Maximum="16" StepFrequency="1"
                                Value="{x:Bind ViewModel.ScanParallelism, Mode=TwoWay}" />
                    </StackPanel>
                    <ToggleSwitch Header="Show hidden files in results"
                                  IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Skip system folders"
                                  IsOn="{x:Bind ViewModel.SkipSystemFolders, Mode=TwoWay}" />
                    <ToggleSwitch Header="Use Turbo Scanner by default (Rust-powered parallel scanner)"
                                  IsOn="{x:Bind ViewModel.UseTurboScanner, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Data Retention" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ScanHistoryRetentionLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <Slider Minimum="30" Maximum="1825" StepFrequency="30"
                                Value="{x:Bind ViewModel.ScanHistoryRetentionDays, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Content="Delete Scan History Older Than Retention Window"
                            Command="{x:Bind ViewModel.PurgeOldHistoryCommand}"
                            IsEnabled="{x:Bind ViewModel.CanPurgeHistory, Mode=OneWay}" />
                    <TextBlock Text="Installer uninstall now preserves your database and settings in %LOCALAPPDATA%\StorageMaster by default."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Excluded paths -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Excluded Paths" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="These folders are skipped during every scan."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <ListView ItemsSource="{x:Bind ViewModel.ExcludedPaths}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="Remove"
                                            Tag="{x:Bind}"
                                            Click="RemovePath_Click"
                                            Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Add Folder..." Click="AddExcludedFolder_Click"/>
                </StackPanel>
            </Border>

            <!-- Cleanup defaults -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Cleanup Defaults" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Recycle Bin"
                                  IsOn="{x:Bind ViewModel.CleanRecycleBin, Mode=TwoWay}" />
                    <ToggleSwitch Header="Temp files"
                                  IsOn="{x:Bind ViewModel.CleanTempFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Downloaded installers"
                                  IsOn="{x:Bind ViewModel.CleanDownloadedInstallers, Mode=TwoWay}" />
                    <ToggleSwitch Header="Cache folders"
                                  IsOn="{x:Bind ViewModel.CleanCacheFolders, Mode=TwoWay}" />
                    <ToggleSwitch Header="Browser cache"
                                  IsOn="{x:Bind ViewModel.CleanBrowserCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Windows Update cache"
                                  IsOn="{x:Bind ViewModel.CleanWindowsUpdateCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Delivery Optimization cache"
                                  IsOn="{x:Bind ViewModel.CleanDeliveryOptimization, Mode=TwoWay}" />
                    <ToggleSwitch Header="Windows Error Reporting"
                                  IsOn="{x:Bind ViewModel.CleanWindowsErrorReports, Mode=TwoWay}" />
                    <ToggleSwitch Header="Program leftovers"
                                  IsOn="{x:Bind ViewModel.CleanProgramLeftovers, Mode=TwoWay}" />
                    <ToggleSwitch Header="Large old files"
                                  IsOn="{x:Bind ViewModel.CleanLargeOldFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Thumbnail cache"
                                  IsOn="{x:Bind ViewModel.CleanThumbnailCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Icon cache"
                                  IsOn="{x:Bind ViewModel.CleanIconCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Font cache"
                                  IsOn="{x:Bind ViewModel.CleanFontCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="DNS cache"
                                  IsOn="{x:Bind ViewModel.CleanDnsCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Prefetch files"
                                  IsOn="{x:Bind ViewModel.CleanPrefetchFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Microsoft Store logs"
                                  IsOn="{x:Bind ViewModel.CleanStoreLogs, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Duplicate Detection Defaults" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <NumberBox Grid.Column="0"
                                   Header="Minimum size (MB)"
                                   Minimum="0"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.DuplicateMinimumSizeMb, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1"
                                  Header="Keeper policy"
                                  ItemsSource="{x:Bind ViewModel.KeeperPolicyOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.DuplicateKeeperPolicy, Mode=TwoWay}" />
                    </Grid>
                    <ToggleSwitch Header="Enable normalized text review"
                                  IsOn="{x:Bind ViewModel.DuplicateUseNormalizedText, Mode=TwoWay}" />
                    <ToggleSwitch Header="Enable image perceptual review"
                                  IsOn="{x:Bind ViewModel.DuplicateUseImagePHash, Mode=TwoWay}" />
                    <ToggleSwitch Header="Enable video perceptual review"
                                  IsOn="{x:Bind ViewModel.DuplicateUseVideoPHash, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <NumberBox Grid.Column="0"
                                   Header="Image pHash threshold"
                                   Minimum="2" Maximum="12"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.DuplicateImagePHashThreshold, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1"
                                   Header="Video frame threshold"
                                   Minimum="2" Maximum="16"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.DuplicateVideoFrameThreshold, Mode=TwoWay}" />
                    </Grid>
                    <NumberBox Header="Max video duration (seconds)"
                               Minimum="60"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind ViewModel.DuplicateMaxVideoDurationSeconds, Mode=TwoWay}" />
                    <StackPanel>
                        <TextBlock Text="FFmpeg executable path (optional)" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay}"
                                 PlaceholderText="C:\Tools\ffmpeg\bin\ffmpeg.exe" />
                        <TextBlock Text="{x:Bind ViewModel.FfmpegPathError, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.HasFfmpegPathError, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Video pHash requires ffmpeg.exe and ffprobe.exe in the same directory."
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Background &amp; Tray" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch Header="Minimize to tray instead of closing"
                                  IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start in tray on Windows sign-in"
                                  IsOn="{x:Bind ViewModel.StartTrayOnLogin, Mode=TwoWay}" />
                    <ToggleSwitch Header="Enable low-disk tray notifications"
                                  IsOn="{x:Bind ViewModel.EnableLowDiskNotifications, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <NumberBox Grid.Column="0"
                                   Header="Warning at % free"
                                   Minimum="1" Maximum="99"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.LowDiskWarningPercent, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1"
                                   Header="Critical at % free"
                                   Minimum="1" Maximum="99"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.LowDiskCriticalPercent, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Low-disk notifications are debounced per drive for 12 hours. Pause is also available from the tray menu."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="Scheduled Jobs" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshScheduledJobsCommand}" />
                        <Button Grid.Column="2" Content="New Job" Command="{x:Bind ViewModel.NewScheduledJobCommand}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.ScheduledJobs}"
                              SelectedItem="{x:Bind ViewModel.SelectedScheduledJob, Mode=TwoWay}"
                              MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ScheduledJobEditorItem">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Info.Job.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Summary}" Opacity="0.75" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Info.StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox Grid.Column="0"
                                 Header="Job name"
                                 Text="{x:Bind ViewModel.ScheduledJobName, Mode=TwoWay}" />
                        <TextBox Grid.Column="1"
                                 Header="Target path"
                                 Text="{x:Bind ViewModel.ScheduledJobTargetPath, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <ComboBox Grid.Column="0"
                                  Header="Action"
                                  ItemsSource="{x:Bind ViewModel.ScheduledJobKindOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ScheduledJobKind, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1"
                                  Header="Frequency"
                                  ItemsSource="{x:Bind ViewModel.ScheduledJobFrequencyOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ScheduledJobFrequency, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2"
                                  Header="Weekly day"
                                  ItemsSource="{x:Bind ViewModel.ScheduledJobDayOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ScheduledJobDay, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox Grid.Column="0"
                                 Header="Start time (HH:mm)"
                                 Text="{x:Bind ViewModel.ScheduledJobTime, Mode=TwoWay}" />
                        <TextBox Grid.Column="1"
                                 Header="Cleanup rules CSV"
                                 PlaceholderText="TempFiles,CacheFolders,BrowserCache"
                                 Text="{x:Bind ViewModel.ScheduledJobRulesCsv, Mode=TwoWay}" />
                    </Grid>

                    <ToggleSwitch Header="Enabled"
                                  IsOn="{x:Bind ViewModel.ScheduledJobEnabled, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Save Job"
                                Command="{x:Bind ViewModel.SaveScheduledJobCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSaveScheduledJob, Mode=OneWay}" />
                        <Button Content="Delete Job"
                                Command="{x:Bind ViewModel.DeleteScheduledJobCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDeleteScheduledJob, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save Settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
                <Button Content="Reset to Defaults"
                        Command="{x:Bind ViewModel.ResetToDefaultsCommand}" />
                <Button Content="Export Diagnostics"
                        Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                        IsEnabled="{x:Bind ViewModel.CanExportDiagnostics, Mode=OneWay}" />
            </StackPanel>

            <!-- Feedback -->
            <TextBlock Text="{x:Bind ViewModel.SavedMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                       Visibility="{x:Bind ViewModel.HasSavedMessage, Mode=OneWay, Converter={StaticResource BoolVis}}" />

            <!-- ── Updates ────────────────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Current version + startup check toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                                <Run Text="Current version: "/>
                                <Run Text="{x:Bind ViewModel.CurrentVersion}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      Header="Check on startup"
                                      IsOn="{x:Bind ViewModel.CheckOnStartup, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" />
                    </Grid>

                    <ToggleSwitch Header="Include pre-release versions"
                                  IsOn="{x:Bind ViewModel.IncludePrerelease, Mode=TwoWay}" />
                    <ToggleSwitch Header="Require signed update installers"
                                  IsOn="{x:Bind ViewModel.RequireSignedUpdates, Mode=TwoWay}" />

                    <!-- Check button + spinner -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="Check for Updates"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                      Width="20" Height="20"
                                      Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <!-- Update available panel -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                Spacing="10">

                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />

                                <!-- Release notes link -->
                                <HyperlinkButton Content="View release notes on GitHub"
                                                 NavigateUri="{x:Bind ViewModel.ReleaseNotesUri, Mode=OneWay}"
                                                 Padding="0" />

                                <!-- Download progress bar (visible while downloading) -->
                                <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                             Maximum="100" Height="6"
                                             Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolVis}}" />

                                <!-- Action row -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Download &amp; Install"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.DownloadAndInstallCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanDownloadAndInstall, Mode=OneWay}" />
                                    <Button Content="Cancel"
                                            Command="{x:Bind ViewModel.CancelDownloadCommand}"
                                            Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Status / error text -->
                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.75" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasUpdateStatusMessage, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="StorageMaster" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                        <Run Text="Version "/>
                        <Run Text="{x:Bind ViewModel.CurrentVersion}" />
                    </TextBlock>
                    <TextBlock Text="Disk usage analyser and cleanup tool for Windows."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
