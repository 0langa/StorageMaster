<Page
    x:Class="StorageMaster.UI.Pages.SettingsPage"
    AutomationProperties.Name="Settings page"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <converters:BoolNegationConverter     x:Key="NotBool" />

        <local:SettingsCategoryTemplateSelector x:Key="CategorySelector"
            GeneralTemplate="{StaticResource GeneralTemplate}"
            ScanningTemplate="{StaticResource ScanningTemplate}"
            CleanupTemplate="{StaticResource CleanupTemplate}"
            DuplicatesTemplate="{StaticResource DuplicatesTemplate}"
            ResultsHistoryTemplate="{StaticResource ResultsHistoryTemplate}"
            SchedulingTemplate="{StaticResource SchedulingTemplate}"
            TrayNotificationsTemplate="{StaticResource TrayNotificationsTemplate}"
            UpdatesTemplate="{StaticResource UpdatesTemplate}"
            AdvancedDiagnosticsTemplate="{StaticResource AdvancedDiagnosticsTemplate}" />

        <!-- General & Appearance -->
        <DataTemplate x:Key="GeneralTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Theme" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ThemeOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind Theme, Mode=TwoWay}"
                              AutomationProperties.Name="Theme"
                              AutomationProperties.HelpText="Choose Light, Dark, or Default to follow Windows." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="UI density" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind UiDensityOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind UiDensity, Mode=TwoWay}"
                              AutomationProperties.Name="UI density"
                              AutomationProperties.HelpText="Compact shows more content. Comfortable adds extra spacing." />
                </StackPanel>

                <ToggleSwitch Header="Reduce animations"
                              IsOn="{x:Bind ReduceAnimations, Mode=TwoWay}"
                              AutomationProperties.Name="Reduce animations"
                              AutomationProperties.HelpText="Turns off motion effects for accessibility and performance." />

                <ToggleSwitch Header="Expand advanced options by default"
                              IsOn="{x:Bind ExpandAdvancedOptionsByDefault, Mode=TwoWay}"
                              AutomationProperties.Name="Expand advanced options by default"
                              AutomationProperties.HelpText="When enabled, advanced sections start expanded instead of collapsed." />

                <StackPanel Spacing="4">
                    <TextBlock Text="Default landing page" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind DefaultLandingPage, Mode=TwoWay}"
                             PlaceholderText="Dashboard"
                             AutomationProperties.Name="Default landing page"
                             AutomationProperties.HelpText="Page name shown on startup, e.g. Dashboard or Scan." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Default scan path" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind DefaultScanPath, Mode=TwoWay}"
                             AutomationProperties.Name="Default scan path"
                             AutomationProperties.HelpText="Folder selected by default when starting a new scan." />
                    <TextBlock Text="{x:Bind DefaultScanPathError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind HasDefaultScanPathError, Mode=OneWay, Converter={StaticResource BoolVis}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Scanning & Performance -->
        <DataTemplate x:Key="ScanningTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ScanParallelismLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Minimum="1" Maximum="16" StepFrequency="1"
                            Value="{x:Bind ScanParallelism, Mode=TwoWay}"
                            AutomationProperties.Name="Scan parallelism"
                            AutomationProperties.HelpText="Number of parallel threads used during file scanning." />
                </StackPanel>

                <ToggleSwitch Header="Show hidden files in results"
                              IsOn="{x:Bind ShowHiddenFiles, Mode=TwoWay}"
                              AutomationProperties.Name="Show hidden files"
                              AutomationProperties.HelpText="Includes files with the hidden attribute in scans." />

                <ToggleSwitch Header="Skip system folders"
                              IsOn="{x:Bind SkipSystemFolders, Mode=TwoWay}"
                              AutomationProperties.Name="Skip system folders"
                              AutomationProperties.HelpText="Skips Windows and Program Files directories to avoid instability." />

                <ToggleSwitch Header="Use Turbo Scanner by default"
                              IsOn="{x:Bind UseTurboScanner, Mode=TwoWay}"
                              AutomationProperties.Name="Use Turbo Scanner by default"
                              AutomationProperties.HelpText="Uses the Rust-powered native scanner when available beside the executable." />

                <StackPanel Spacing="12">
                    <TextBlock Text="Excluded Paths" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="These folders are skipped during every scan."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ListView ItemsSource="{x:Bind ExcludedPaths}" SelectionMode="None" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="Excluded path" />
                                    <Button Grid.Column="1" Content="Remove"
                                            Tag="{x:Bind}"
                                            Click="RemovePath_Click"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Remove excluded path"
                                            AutomationProperties.HelpText="Remove this folder from the exclusion list." />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Add Folder..." Click="AddExcludedFolder_Click"
                            AutomationProperties.Name="Add excluded folder"
                            AutomationProperties.HelpText="Choose a folder to exclude from all future scans." />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Cleanup & Safety -->
        <DataTemplate x:Key="CleanupTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <InfoBar Message="Cleanup permanently removes files. Enable Recycle Bin or dry-run until you are confident."
                         Severity="Informational" IsOpen="True" IsClosable="False" />

                <ToggleSwitch Header="Send to Recycle Bin (recommended)"
                              IsOn="{x:Bind PreferRecycleBin, Mode=TwoWay}"
                              AutomationProperties.Name="Prefer Recycle Bin"
                              AutomationProperties.HelpText="Moves deleted files to the Recycle Bin so they can be restored. Turning this off enables permanent deletion." />

                <ToggleSwitch Header="Dry-run mode by default"
                              IsOn="{x:Bind DryRunByDefault, Mode=TwoWay}"
                              AutomationProperties.Name="Dry-run mode by default"
                              AutomationProperties.HelpText="Previews what would be deleted without actually removing anything." />

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind LargeFileThresholdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Minimum="50" Maximum="5000" StepFrequency="50"
                            Value="{x:Bind LargeFileSizeMb, Mode=TwoWay}"
                            AutomationProperties.Name="Large file threshold"
                            AutomationProperties.HelpText="Files larger than this are flagged as large-file cleanup candidates." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind OldFileAgeThresholdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Minimum="30" Maximum="3650" StepFrequency="30"
                            Value="{x:Bind OldFileAgeDays, Mode=TwoWay}"
                            AutomationProperties.Name="Old file age threshold"
                            AutomationProperties.HelpText="Files older than this are flagged as old-file cleanup candidates." />
                </StackPanel>

                <TextBlock Text="Default cleanup rules" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Rules enabled here are selected by default on the Cleanup page."
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />

                <StackPanel Spacing="10">
                    <ToggleSwitch Header="Recycle Bin" IsOn="{x:Bind CleanRecycleBin, Mode=TwoWay}" />
                    <ToggleSwitch Header="Temp files" IsOn="{x:Bind CleanTempFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Downloaded installers" IsOn="{x:Bind CleanDownloadedInstallers, Mode=TwoWay}" />
                    <ToggleSwitch Header="Cache folders" IsOn="{x:Bind CleanCacheFolders, Mode=TwoWay}" />
                    <ToggleSwitch Header="Browser cache" IsOn="{x:Bind CleanBrowserCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Windows Update cache" IsOn="{x:Bind CleanWindowsUpdateCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Delivery Optimization cache" IsOn="{x:Bind CleanDeliveryOptimization, Mode=TwoWay}" />
                    <ToggleSwitch Header="Windows Error Reporting" IsOn="{x:Bind CleanWindowsErrorReports, Mode=TwoWay}" />
                    <ToggleSwitch Header="Program leftovers" IsOn="{x:Bind CleanProgramLeftovers, Mode=TwoWay}" />
                    <ToggleSwitch Header="Large old files" IsOn="{x:Bind CleanLargeOldFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Thumbnail cache" IsOn="{x:Bind CleanThumbnailCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Icon cache" IsOn="{x:Bind CleanIconCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Font cache" IsOn="{x:Bind CleanFontCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="DNS cache" IsOn="{x:Bind CleanDnsCache, Mode=TwoWay}" />
                    <ToggleSwitch Header="Prefetch files" IsOn="{x:Bind CleanPrefetchFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Microsoft Store logs" IsOn="{x:Bind CleanStoreLogs, Mode=TwoWay}" />
                </StackPanel>

                <ToggleSwitch Header="Clear entire Downloads folder"
                              IsOn="{x:Bind ClearEntireDownloads, Mode=TwoWay}"
                              AutomationProperties.Name="Clear entire Downloads folder"
                              AutomationProperties.HelpText="Clears all files in Downloads, not just installer files. Requires the Downloaded Installers rule to be enabled." />
            </StackPanel>
        </DataTemplate>

        <!-- Duplicates & Matching -->
        <DataTemplate x:Key="DuplicatesTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <InfoBar Message="Perceptual matching can return false positives. Always review fuzzy results before deleting."
                         Severity="Warning" IsOpen="True" IsClosable="False" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <NumberBox Grid.Column="0"
                               Header="Minimum size (MB)"
                               Minimum="0"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind DuplicateMinimumSizeMb, Mode=TwoWay}"
                               AutomationProperties.Name="Duplicate minimum size"
                               AutomationProperties.HelpText="Files smaller than this are ignored during duplicate analysis." />
                    <ComboBox Grid.Column="1"
                              Header="Keeper policy"
                              ItemsSource="{x:Bind KeeperPolicyOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind DuplicateKeeperPolicy, Mode=TwoWay}"
                              AutomationProperties.Name="Keeper policy"
                              AutomationProperties.HelpText="Which file to keep when duplicates are found, e.g. newest or largest." />
                </Grid>

                <ToggleSwitch Header="Enable normalized text review"
                              IsOn="{x:Bind DuplicateUseNormalizedText, Mode=TwoWay}"
                              AutomationProperties.Name="Enable normalized text review"
                              AutomationProperties.HelpText="Compares text files after normalising line endings and whitespace." />

                <ToggleSwitch Header="Enable image perceptual review"
                              IsOn="{x:Bind DuplicateUseImagePHash, Mode=TwoWay}"
                              AutomationProperties.Name="Enable image perceptual review"
                              AutomationProperties.HelpText="Groups visually similar images using perceptual hash. Slower but finds resized or re-encoded photos." />

                <ToggleSwitch Header="Enable video perceptual review"
                              IsOn="{x:Bind DuplicateUseVideoPHash, Mode=TwoWay}"
                              AutomationProperties.Name="Enable video perceptual review"
                              AutomationProperties.HelpText="Groups visually similar videos using frame hashes. Requires FFmpeg and ffprobe." />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <NumberBox Grid.Column="0"
                               Header="Image pHash threshold"
                               Minimum="2" Maximum="12"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind DuplicateImagePHashThreshold, Mode=TwoWay}"
                               AutomationProperties.Name="Image perceptual hash threshold"
                               AutomationProperties.HelpText="Lower values require closer visual match. 6 is a balanced default." />
                    <NumberBox Grid.Column="1"
                               Header="Video frame threshold"
                               Minimum="2" Maximum="16"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind DuplicateVideoFrameThreshold, Mode=TwoWay}"
                               AutomationProperties.Name="Video frame threshold"
                               AutomationProperties.HelpText="Number of sampled frames compared for video similarity." />
                </Grid>

                <NumberBox Header="Max video duration (seconds)"
                           Minimum="60"
                           SpinButtonPlacementMode="Inline"
                           Value="{x:Bind DuplicateMaxVideoDurationSeconds, Mode=TwoWay}"
                           AutomationProperties.Name="Maximum video duration"
                           AutomationProperties.HelpText="Videos longer than this are skipped in perceptual analysis to save time." />

                <StackPanel Spacing="4">
                    <TextBlock Text="FFmpeg executable path (optional)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind FfmpegPath, Mode=TwoWay}"
                             PlaceholderText="C:\Tools\ffmpeg\bin\ffmpeg.exe"
                             AutomationProperties.Name="FFmpeg executable path"
                             AutomationProperties.HelpText="Path to ffmpeg.exe. Leave blank to auto-detect from bundled tools or PATH." />
                    <TextBlock Text="{x:Bind FfmpegPathError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind HasFfmpegPathError, Mode=OneWay, Converter={StaticResource BoolVis}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind FfmpegDetectionText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Video pHash requires ffmpeg.exe and ffprobe.exe in the same directory."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Default review mode" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind DefaultDuplicatesReviewMode, Mode=TwoWay}"
                             PlaceholderText="Exact"
                             AutomationProperties.Name="Default duplicates review mode"
                             AutomationProperties.HelpText="Default method selected when opening Duplicates, e.g. Exact or NormalizedText." />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Results & History -->
        <DataTemplate x:Key="ResultsHistoryTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ScanHistoryRetentionLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Minimum="30" Maximum="1825" StepFrequency="30"
                            Value="{x:Bind ScanHistoryRetentionDays, Mode=TwoWay}"
                            AutomationProperties.Name="Scan history retention"
                            AutomationProperties.HelpText="How many days to keep completed scan sessions in the database." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Default results page size" Style="{StaticResource CaptionTextBlockStyle}" />
                    <NumberBox Minimum="10" Maximum="1000" SpinButtonPlacementMode="Inline"
                               Value="{x:Bind DefaultResultsPageSize, Mode=TwoWay}"
                               AutomationProperties.Name="Default results page size"
                               AutomationProperties.HelpText="Number of rows loaded per page on the Results page." />
                </StackPanel>

                <Button Content="Delete Scan History Older Than Retention Window"
                        Command="{x:Bind PurgeOldHistoryCommand}"
                        IsEnabled="{x:Bind CanPurgeHistory, Mode=OneWay}"
                        AutomationProperties.Name="Purge old scan history"
                        AutomationProperties.HelpText="Permanently removes scan sessions older than the retention days." />

                <TextBlock Text="Installer uninstall now preserves your database and settings in %LOCALAPPDATA%\StorageMaster by default."
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- Scheduling & Automation -->
        <DataTemplate x:Key="SchedulingTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <ToggleSwitch Header="Enable scheduled tasks"
                              IsOn="{x:Bind ScheduledTasksEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Enable scheduled tasks"
                              AutomationProperties.HelpText="Allows StorageMaster to register Windows Scheduled Tasks for scans and cleanup." />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="Scheduled Jobs" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh" Command="{x:Bind RefreshScheduledJobsCommand}" />
                    <Button Grid.Column="2" Content="New Job" Command="{x:Bind NewScheduledJobCommand}" />
                </Grid>

                <ListView ItemsSource="{x:Bind ScheduledJobs}"
                          SelectedItem="{x:Bind SelectedScheduledJob, Mode=TwoWay}"
                          MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ScheduledJobEditorItem">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Info.Job.Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Summary}" Opacity="0.75" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Info.StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Header="Job name"
                             Text="{x:Bind ScheduledJobName, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Header="Target path"
                             Text="{x:Bind ScheduledJobTargetPath, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <ComboBox Grid.Column="0"
                              Header="Action"
                              ItemsSource="{x:Bind ScheduledJobKindOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ScheduledJobKind, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1"
                              Header="Frequency"
                              ItemsSource="{x:Bind ScheduledJobFrequencyOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ScheduledJobFrequency, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2"
                              Header="Weekly day"
                              ItemsSource="{x:Bind ScheduledJobDayOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ScheduledJobDay, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Header="Start time (HH:mm)"
                             Text="{x:Bind ScheduledJobTime, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Header="Cleanup rules CSV"
                             PlaceholderText="TempFiles,CacheFolders,BrowserCache"
                             Text="{x:Bind ScheduledJobRulesCsv, Mode=TwoWay}" />
                </Grid>

                <ToggleSwitch Header="Enabled"
                              IsOn="{x:Bind ScheduledJobEnabled, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Save Job"
                            Command="{x:Bind SaveScheduledJobCommand}"
                            IsEnabled="{x:Bind CanSaveScheduledJob, Mode=OneWay}" />
                    <Button Content="Delete Job"
                            Command="{x:Bind DeleteScheduledJobCommand}"
                            IsEnabled="{x:Bind CanDeleteScheduledJob, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Background, Tray & Notifications -->
        <DataTemplate x:Key="TrayNotificationsTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <ToggleSwitch Header="Minimize to tray instead of closing"
                              IsOn="{x:Bind MinimizeToTray, Mode=TwoWay}"
                              AutomationProperties.Name="Minimize to tray"
                              AutomationProperties.HelpText="Keeps StorageMaster running in the system tray when you close the window." />

                <ToggleSwitch Header="Start in tray on Windows sign-in"
                              IsOn="{x:Bind StartTrayOnLogin, Mode=TwoWay}"
                              AutomationProperties.Name="Start in tray on sign-in"
                              AutomationProperties.HelpText="Launches StorageMaster automatically when you log in." />

                <ToggleSwitch Header="Enable low-disk tray notifications"
                              IsOn="{x:Bind EnableLowDiskNotifications, Mode=TwoWay}"
                              AutomationProperties.Name="Enable low-disk notifications"
                              AutomationProperties.HelpText="Shows a tray balloon when a drive drops below the warning threshold." />

                <ToggleSwitch Header="Enable drive-health notifications"
                              IsOn="{x:Bind EnableDriveHealthNotifications, Mode=TwoWay}"
                              AutomationProperties.Name="Enable drive-health notifications"
                              AutomationProperties.HelpText="Shows a tray balloon when Windows storage telemetry reports a warning or unhealthy disk." />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <NumberBox Grid.Column="0"
                               Header="Warning at % free"
                               Minimum="1" Maximum="99"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind LowDiskWarningPercent, Mode=TwoWay}"
                               AutomationProperties.Name="Low disk warning percent"
                               AutomationProperties.HelpText="Free-space percentage that triggers a warning notification." />
                    <NumberBox Grid.Column="1"
                               Header="Critical at % free"
                               Minimum="1" Maximum="99"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind LowDiskCriticalPercent, Mode=TwoWay}"
                               AutomationProperties.Name="Low disk critical percent"
                               AutomationProperties.HelpText="Free-space percentage that triggers a critical notification." />
                </Grid>

                <TextBlock Text="Low-disk and drive-health notifications are debounced per drive for 12 hours. Pause is also available from the tray menu."
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- Updates & Security -->
        <DataTemplate x:Key="UpdatesTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                            <Run Text="Current version: "/>
                            <Run Text="{x:Bind CurrentVersion}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  Header="Check on startup"
                                  IsOn="{x:Bind CheckOnStartup, Mode=TwoWay}"
                                  OnContent="" OffContent=""
                                  MinWidth="0"
                                  AutomationProperties.Name="Check for updates on startup"
                                  AutomationProperties.HelpText="Automatically looks for new releases when the app starts." />
                </Grid>

                <ToggleSwitch Header="Include pre-release versions"
                              IsOn="{x:Bind IncludePrerelease, Mode=TwoWay}"
                              AutomationProperties.Name="Include pre-release versions"
                              AutomationProperties.HelpText="Offers beta and preview builds during update checks." />

                <ToggleSwitch Header="Require signed update installers"
                              IsOn="{x:Bind RequireSignedUpdates, Mode=TwoWay}"
                              AutomationProperties.Name="Require signed update installers"
                              AutomationProperties.HelpText="Only installs updates that pass code-signature verification." />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="Check for Updates"
                            Command="{x:Bind CheckForUpdatesCommand}"
                            IsEnabled="{x:Bind CanCheckForUpdates, Mode=OneWay}"
                            AutomationProperties.Name="Check for updates"
                            AutomationProperties.HelpText="Manually query GitHub for the latest release." />
                    <ProgressRing IsActive="{x:Bind IsCheckingForUpdates, Mode=OneWay}"
                                  Width="20" Height="20"
                                  Visibility="{x:Bind IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <StackPanel Visibility="{x:Bind HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolVis}}"
                            Spacing="10">
                    <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind UpdateAvailableText, Mode=OneWay}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <HyperlinkButton Content="View release notes on GitHub"
                                             NavigateUri="{x:Bind ReleaseNotesUri, Mode=OneWay}"
                                             Padding="0" />
                            <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                         Maximum="100" Height="6"
                                         Visibility="{x:Bind IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Download &amp; Install"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind DownloadAndInstallCommand}"
                                        IsEnabled="{x:Bind CanDownloadAndInstall, Mode=OneWay}" />
                                <Button Content="Cancel"
                                        Command="{x:Bind CancelDownloadCommand}"
                                        Visibility="{x:Bind IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{x:Bind UpdateStatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.75" TextWrapping="Wrap"
                           Visibility="{x:Bind HasUpdateStatusMessage, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Advanced Diagnostics & About -->
        <DataTemplate x:Key="AdvancedDiagnosticsTemplate" x:DataType="local:SettingsViewModel">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="StorageMaster" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                        <Run Text="Version "/>
                        <Run Text="{x:Bind CurrentVersion}" />
                    </TextBlock>
                    <TextBlock Text="Disk usage analyser and cleanup tool for Windows."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="Export Diagnostics"
                        Command="{x:Bind ExportDiagnosticsCommand}"
                        IsEnabled="{x:Bind CanExportDiagnostics, Mode=OneWay}"
                        AutomationProperties.Name="Export diagnostics"
                        AutomationProperties.HelpText="Creates a zip with logs, version info, and settings for support." />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Hub -->
        <ScrollViewer Padding="32,24"
                      Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay, Converter={StaticResource InvBoolVis}}">
            <StackPanel Spacing="24" MaxWidth="1120" HorizontalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" />

                <TextBox PlaceholderText="Search settings..."
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search settings"
                         AutomationProperties.HelpText="Filter categories by title or description." />

                <GridView ItemsSource="{x:Bind ViewModel.FilteredCategories, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="CategoriesGridView_ItemClick">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:SettingsCategoryItem">
                            <controls:SettingsCard Title="{x:Bind Title}"
                                                   Description="{x:Bind Description}"
                                                   IconGlyph="{x:Bind IconGlyph}"
                                                   BadgeText="{x:Bind StatusSummary}"
                                                   WarningText="{x:Bind WarningText}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <InfoBar Message="{x:Bind ViewModel.SavedMessage, Mode=OneWay}"
                         Severity="Success"
                         IsOpen="{x:Bind ViewModel.HasSavedMessage, Mode=OneWay}"
                         IsClosable="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- Editor overlay -->
        <Grid Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay, Converter={StaticResource BoolVis}}"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1" Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="0"
                    MaxWidth="860"
                    MaxHeight="780"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Padding="24,20" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.SelectedCategoryTitle, Mode=OneWay}"
                                   Style="{StaticResource TitleTextBlockStyle}" />
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.CloseEditorCommand}"
                                AutomationProperties.Name="Close settings editor"
                                AutomationProperties.HelpText="Close the settings editor without saving."
                                Padding="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" Padding="24">
                        <ContentControl x:Name="EditorContentControl"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplateSelector="{StaticResource CategorySelector}" />
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Padding="24" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.EditorValidationMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="Reset Category"
                                Command="{x:Bind ViewModel.ResetCategoryCommand}"
                                AutomationProperties.Name="Reset category to defaults"
                                AutomationProperties.HelpText="Revert all settings in this category to their factory defaults." />
                        <Button Grid.Column="2"
                                Content="Cancel"
                                Command="{x:Bind ViewModel.CancelCategoryCommand}"
                                AutomationProperties.Name="Cancel changes"
                                AutomationProperties.HelpText="Discard any edits made in this category." />
                        <Button Grid.Column="3"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                AutomationProperties.Name="Save settings"
                                AutomationProperties.HelpText="Validate and save all settings." />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
