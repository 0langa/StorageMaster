<Page
    x:Class="StorageMaster.UI.Pages.SmartCleanerPage"
    AutomationProperties.Name="Smart Cleaner page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageMaster.UI.Controls"
    xmlns:local="using:StorageMaster.UI.Pages"
    xmlns:converters="using:StorageMaster.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePaddingWide}">
        <StackPanel Spacing="{StaticResource SectionSpacing}" MaxWidth="800" HorizontalAlignment="Left">

            <!--
                Scan and Analyse is the one primary action, so it sits in the
                header like every other page's primary action. Clean Selected
                appears only once there is something to clean, next to the total
                it would remove.
            -->
            <controls:PageHeader Title="Smart Cleaner"
                                 Subtitle="Scans seven common junk sources and removes only what you select.">
                <controls:PageHeader.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <Button Content="Cancel"
                                Style="{StaticResource CommandButtonStyle}"
                                Command="{x:Bind ViewModel.CancelCurrentCommand}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        <Button Content="Scan &amp; Analyse"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.AnalyseCommand}"
                                IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}" />
                    </StackPanel>
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <FontIcon Glyph="{StaticResource IconSmartCleaner}" FontSize="28"
                                  Foreground="{ThemeResource SmAccentOnSurfaceBrush}" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="One-click junk removal"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Analysis is read-only. Nothing is removed until you select categories and confirm."
                                       Style="{StaticResource HelperTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Deletion mode -->
                    <ToggleSwitch Header="Send deletions to Recycle Bin (recommended)"
                                  IsOn="{x:Bind ViewModel.UseRecycleBin, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Scanning spinner -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource HelperTextStyle}" />
            </StackPanel>

            <!-- Cleaning spinner -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"
                        Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource HelperTextStyle}" />
            </StackPanel>

            <!-- Status text -->
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvBoolVis}}" />

            <!-- Completion banner -->
            <InfoBar IsOpen="True" Severity="{x:Bind ViewModel.CompletionSeverity, Mode=OneWay}"
                      Title="Cleanup result"
                      Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.CleaningDone, Mode=OneWay, Converter={StaticResource BoolVis}}" />

            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind ViewModel.HasFailureDetails, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <StackPanel Spacing="{StaticResource TightSpacing}">
                    <TextBlock Text="Failure and audit details" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.FailureDetails}"
                              MaxHeight="240" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Results: group list -->
            <StackPanel Spacing="16"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolVis}}">

                <!-- Total selected size bar -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="{StaticResource CardPaddingCompact}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Total selected to clean" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}"
                                       Style="{StaticResource MetricTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clean Selected"
                                Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.CleanCommand}"
                                IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Group cards -->
                <ListView ItemsSource="{x:Bind ViewModel.Groups}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          MaxHeight="{StaticResource ListMaxHeight}"
                          IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SmartCleanGroupItem">
                            <Border Style="{StaticResource ListRowCardStyle}">
                                <!-- Fixed size column so the values line up down the list. -->
                                <Grid ColumnDefinitions="Auto,*,120" ColumnSpacing="14">
                                    <!-- Toggle -->
                                    <!-- Compiled binding: the template already declares
                                         x:DataType, so the reflection binding cost a
                                         BindingExpression per row for no benefit. -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <!-- Name + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Category}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource HelperTextStyle}"
                                                   MaxLines="2"/>
                                    </StackPanel>
                                    <!-- Size -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind SizeDisplay}"
                                               Style="{StaticResource MetricColumnTextStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
