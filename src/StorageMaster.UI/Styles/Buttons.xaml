<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A merged dictionary cannot see its siblings while it is being parsed, so it
        must merge the palette it references itself. Without this, StaticResource
        lookups here fail at startup with "Cannot find a Resource with the Name/Key".
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PaletteBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        Button ranks, highest first:
          AccentButtonStyle    — the one primary action on a page. Its colours come
                                 from the selected accent via Styles/Palette.xaml.
          CommandButtonStyle   — an ordinary command. Sized to match the accent
                                 button so a row of buttons has one baseline.
          IconCommandButtonStyle — a glyph-only command in a dense row.
          PillButtonStyle      — a filter or segment, not an action.
        Anything that is not one of these is decoration and should not be a button.
    -->

    <Style x:Key="CommandButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
    </Style>

    <Style x:Key="IconCommandButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
    </Style>

    <!-- A column heading that sorts when clicked; a heading first, a button second. -->
    <Style x:Key="ColumnSortButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SmTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
