<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One palette for file-type colour, shared by the Space Map legend, the
        treemap tiles and any future category chart.

        These used to be fixed hex values while TreemapTileControl painted its
        tiles from a second, hardcoded set of named colours in C#. The two sets
        had drifted: the legend said videos were magenta while the map drew them
        red, so the key actively misled. Aliasing both onto the categorical ramp
        means there is one source of truth, it is contrast-checked against the
        chart well by ThemeContrastTests, and it follows the selected theme.

        Slot assignment is stable on purpose — changing it re-colours every
        existing screenshot and every user's mental map — so add categories at
        the end rather than reshuffling.
    -->
    <StaticResource x:Key="FileTypeDocumentBrush"   ResourceKey="SmCategorical0Brush" />
    <StaticResource x:Key="FileTypeFolderBrush"     ResourceKey="SmCategorical1Brush" />
    <StaticResource x:Key="FileTypeCacheBrush"      ResourceKey="SmCategorical2Brush" />
    <StaticResource x:Key="FileTypeImageBrush"      ResourceKey="SmCategorical3Brush" />
    <StaticResource x:Key="FileTypeExecutableBrush" ResourceKey="SmCategorical4Brush" />
    <StaticResource x:Key="FileTypeVideoBrush"      ResourceKey="SmCategorical5Brush" />
    <StaticResource x:Key="FileTypeArchiveBrush"    ResourceKey="SmCategorical6Brush" />
    <StaticResource x:Key="FileTypeAudioBrush"      ResourceKey="SmCategorical7Brush" />

    <!-- Source code shares the document hue: both are "things you authored". -->
    <StaticResource x:Key="FileTypeSourceCodeBrush" ResourceKey="SmCategorical0Brush" />

    <!-- Uncategorised and system content stays neutral so it never competes
         for attention with a category the user is actually hunting for. -->
    <StaticResource x:Key="FileTypeSystemBrush" ResourceKey="SmTextMutedBrush" />
    <StaticResource x:Key="FileTypeOtherBrush"  ResourceKey="SmTextMutedBrush" />
</ResourceDictionary>
