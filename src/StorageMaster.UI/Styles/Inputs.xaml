<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One control height across every toolbar, so a filter row reads as a row. -->
    <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="FilterNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <!--
        WinUI supplies a ToggleSwitch's On/Off text from the Windows display
        language, not from the app's resources. On a German install that rendered
        "Ein"/"Aus" beside English labels throughout an English app.

        ApplicationLanguages.PrimaryLanguageOverride is the documented fix, but it
        is silently ignored for an unpackaged app like this one — the call succeeds
        and nothing changes. Setting the content explicitly is what actually works.

        This is an implicit style, so it reaches every ToggleSwitch without each
        page opting in. When real translations ship, these two strings become
        resource lookups like any other.
    -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="On" />
        <Setter Property="OffContent" Value="Off" />
    </Style>

</ResourceDictionary>
