<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:StorageMaster.UI.Infrastructure"
    xmlns:converters="using:StorageMaster.UI.Converters">

    <converters:EnumDisplayConverter x:Key="EnumDisplay" />

    <!--
        Drop-downs bind straight to Enum.GetValues, so without this they render the
        identifier — "WholeSession", "CleanupExecuteSafe" — in every language.
        Defined here rather than per page so a new enum drop-down anywhere gets it
        by asking for one resource.

        Classic Binding rather than x:Bind: the bound item is the enum value itself.
    -->
    <DataTemplate x:Key="EnumItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
    </DataTemplate>

    <!-- One control height across every toolbar, so a filter row reads as a row. -->
    <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="FilterNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <!--
        Pivot headers ship at title size, which spends an enormous amount of width
        on a tab strip. Five tabs fit in English and German and only four in
        Spanish, and Pivot reveals its scroll chevrons only on hover — so at rest
        the fifth tab does not look scrolled-off, it looks absent. A Spanish user
        had no way to discover "Estructura de carpetas" existed.

        Shrinking the header type fixes every language at once, which is the right
        trade: the alternative was shortening correct translations to fit a control
        that was simply oversized.
    -->
    <Style TargetType="PivotHeaderItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!--
        WinUI supplies a ToggleSwitch's On/Off text from the Windows display
        language, not from the app's resources. On a German install that rendered
        "Ein"/"Aus" beside English labels throughout an English app.

        ApplicationLanguages.PrimaryLanguageOverride is the documented fix, but it
        is silently ignored for an unpackaged app like this one — the call succeeds
        and nothing changes. Setting the content explicitly is what actually works.

        This is an implicit style, so it reaches every ToggleSwitch without each
        page opting in.
    -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="{i18n:Loc Key=Common_On}" />
        <Setter Property="OffContent" Value="{i18n:Loc Key=Common_Off}" />
    </Style>

</ResourceDictionary>
