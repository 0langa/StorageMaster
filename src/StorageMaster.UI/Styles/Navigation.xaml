<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A merged dictionary cannot see its siblings while it is being parsed, so it
        must merge the palette it references itself. Without this, StaticResource
        lookups here fail at startup with "Cannot find a Resource with the Name/Key".
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PaletteBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        Uses the palette's secondary text brush like every other surface. WinUI's own
        TextFillColorSecondaryBrush lives in XamlControlsResources' ThemeDictionaries
        and is not resolvable from a dictionary merged at Application level — doing so
        crashed startup with "Cannot find a Resource with the Name/Key".

        The palette is seeded with its default values before the first window is
        created, so this brush is never transparent on the first frame.
    -->
    <Style x:Key="GlobalStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource SmTextSecondaryBrush}" />
        <!--
            Two lines, then ellipsis. The pane is a fixed width, and German runs
            long enough that a single no-wrap line cut "Überprüfung starten, um
            Daten für den Überblick zu sammeln." off mid-word.
        -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
</ResourceDictionary>
