<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Deliberately on WinUI's own secondary text brush rather than the palette's.
        The shell chrome is painted in the first frame, before ThemeService has read
        settings and filled in the palette, and a palette brush is still transparent
        at that point. Page content can absorb a frame of that; the always-visible
        status strip cannot, and the two greys are visually equivalent anyway.
    -->
    <Style x:Key="GlobalStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
</ResourceDictionary>
