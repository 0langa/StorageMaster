<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Severity brushes are aliases onto the runtime palette published by
        ThemeService, not fixed colours. The previous fixed values were tuned for
        dark only and failed contrast in light theme, and they could not respond to
        the selected accent's neutral base.

        Fill is for bars, dots and gauges; Text is for labels. A colour dense enough
        to read as body text is usually too dark to work as a fill, so the two are
        tuned independently in ThemeCatalog and verified by ThemeContrastTests.
    -->
    <StaticResource x:Key="SeverityHealthyBrush"  ResourceKey="SmSeverityHealthyBrush" />
    <StaticResource x:Key="SeverityWatchBrush"    ResourceKey="SmSeverityWatchBrush" />
    <StaticResource x:Key="SeverityWarningBrush"  ResourceKey="SmSeverityWarningBrush" />
    <StaticResource x:Key="SeverityCriticalBrush" ResourceKey="SmSeverityCriticalBrush" />
    <StaticResource x:Key="SeverityUnknownBrush"  ResourceKey="SmSeverityUnknownBrush" />

    <StaticResource x:Key="SeverityHealthyTextBrush"  ResourceKey="SmSeverityHealthyTextBrush" />
    <StaticResource x:Key="SeverityWatchTextBrush"    ResourceKey="SmSeverityWatchTextBrush" />
    <StaticResource x:Key="SeverityWarningTextBrush"  ResourceKey="SmSeverityWarningTextBrush" />
    <StaticResource x:Key="SeverityCriticalTextBrush" ResourceKey="SmSeverityCriticalTextBrush" />
    <StaticResource x:Key="SeverityUnknownTextBrush"  ResourceKey="SmSeverityUnknownTextBrush" />

</ResourceDictionary>
