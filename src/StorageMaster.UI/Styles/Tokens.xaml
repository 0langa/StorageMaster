<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Spacing rhythm. Everything in the app should land on one of these four
        steps: 8 inside a control group, 12 between controls, 16 between cards,
        24 between page sections. Pages that invent their own numbers drift out
        of alignment with their neighbours, which is what made the earlier
        screens read as a collection of pages rather than one instrument panel.
    -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PagePaddingWide">32,24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16,12</Thickness>
    <Thickness x:Key="ChipPadding">8,4</Thickness>
    <Thickness x:Key="WellPadding">8</Thickness>

    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">999</CornerRadius>

    <x:Double x:Key="PageMaxWidth">1180</x:Double>
    <x:Double x:Key="SectionSpacing">24</x:Double>
    <x:Double x:Key="CardSpacing">16</x:Double>
    <x:Double x:Key="ControlSpacing">12</x:Double>
    <x:Double x:Key="TightSpacing">8</x:Double>
    <x:Double x:Key="SecondaryTextOpacity">0.70</x:Double>
    <x:Double x:Key="MutedTextOpacity">0.55</x:Double>

    <!--
        A list inside a scrolling page must be given bounds. Measured with an
        infinite viewport an ItemsStackPanel culls nothing and realises every
        row, so a thousand-row result set is built in one UI-thread pass. These
        are the standard bounds; use them rather than a fresh literal so every
        list on every page virtualises the same way at every display scale.
    -->
    <x:Double x:Key="ListMinHeight">160</x:Double>
    <x:Double x:Key="ListMaxHeight">560</x:Double>
    <x:Double x:Key="ListMaxHeightTall">620</x:Double>

    <!-- The side rail on split pages: wide enough for its buttons, never star-sized. -->
    <x:Double x:Key="SidePanelMinWidth">260</x:Double>
    <x:Double x:Key="SidePanelMaxWidth">320</x:Double>

</ResourceDictionary>
